# Public Formspree form ID used by the /contacto form to POST submissions.
# Get one at https://formspree.io and copy the value into a local .env file.
PUBLIC_FORMSPREE_FORM_ID=
# Formspree form ID for the contact form (https://formspree.io)
# Leave empty to use mailto fallback
PUBLIC_FORMSPREE_FORM_ID=
