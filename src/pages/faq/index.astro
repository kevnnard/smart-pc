---
import Footer from "../../components/footer/Footer.astro";
import Navbar from "../../components/navbar/Navbar.astro";
import CTAButton from "../../components/ui/CTAButton.astro";
import { faq } from "../../data/home";
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageMeta = {
  title: "Preguntas Frecuentes (FAQ) | smart-pc",
  description:
    "Respuestas directas sobre ensambles a medida, tiempos de entrega, formas de pago, garantías y soporte técnico en Colombia.",
};

const extendedFaq = [
  ...faq,
  {
    question: "¿Los componentes son 100% nuevos y sellados?",
    answer:
      "Absolutamente. Cada componente proviene de distribuidores autorizados en Colombia con número de serie registrable. Te enviamos todas las cajas, manuales y accesorios originales junto con el computador armado.",
  },
  {
    question: "¿Qué pruebas realizan antes de entregar el computador?",
    answer:
      "Cada equipo pasa por un riguroso banco de pruebas: inspección física de pines, actualización a la última versión de BIOS estable, activación de perfiles XMP/EXPO de memoria a su frecuencia nominal, test de estrés de 12 horas (Cinebench para CPU, FurMark para GPU y MemTest para RAM) y monitoreo de temperaturas ambiente.",
  },
  {
    question: "¿Hacen envíos a ciudades fuera de Bogotá?",
    answer:
      "Sí, realizamos envíos a todo el territorio colombiano con seguro por el 100% del valor comercial declarado a través de Coordinadora, Servientrega, Envía o la transportadora que elijas. Para clientes en Bogotá contamos con entrega personal en taller con verificación de arranque.",
  },
  {
    question: "¿Puedo pedir que no instalen sistema operativo?",
    answer:
      "Sí. Podés solicitar tu equipo sin sistema operativo o con Windows 11 instalado sin licencia comercial activa para que vos ingreses tu propia clave.",
  },
  {
    question: "¿Cuál es el horario de atención para consultas y cotizaciones?",
    answer:
      "Atendemos por WhatsApp (+57 318 546 7155) y correo oficial (smart-pc@kevnard.com) de lunes a viernes de 10:00 AM a 5:00 PM. No atendemos fines de semana ni festivos.",
  },
];
---

<BaseLayout {...pageMeta}>
  <Navbar slot="navbar" />

  <main>
    <!-- Hero -->
    <section class="relative isolate overflow-hidden bg-navy-950 pb-12 pt-20 md:pt-28">
      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <div class="absolute -top-32 left-1/2 h-[450px] w-[650px] -translate-x-1/2 rounded-full bg-cyan-500/10 blur-3xl"></div>
        <div class="absolute right-0 top-1/4 h-72 w-72 translate-x-1/3 rounded-full bg-blue-600/10 blur-3xl"></div>
      </div>

      <div class="mx-auto flex w-full max-w-[1280px] flex-col items-center gap-6 px-4 text-center md:px-8">
        <div class="flex items-center gap-2 rounded-full border border-cyan-500/20 bg-cyan-500/8 px-4 py-1.5 shadow-sm">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-cyan-400"></span>
          <span class="font-mono text-[11px] font-semibold uppercase tracking-widest text-cyan-400">Centro de Ayuda</span>
        </div>

        <h1 class="text-4xl font-bold tracking-tight text-text-primary md:text-6xl">
          Preguntas Frecuentes.<br />
          <span class="bg-gradient-to-r from-cyan-400 via-cyan-300 to-blue-400 bg-clip-text text-transparent">
            Claridad técnica sin rodeos.
          </span>
        </h1>

        <p class="max-w-2xl text-base leading-relaxed text-text-secondary md:text-lg">
          Resolvemos las dudas más comunes sobre nuestro proceso de cotización, ensamblaje, formas de pago y logística de entrega en Colombia.
        </p>
      </div>
    </section>

    <!-- Lista de FAQ -->
    <section class="border-y border-border/60 bg-navy-900/30 py-16" aria-labelledby="faq-list-heading">
      <div class="mx-auto max-w-4xl px-4 md:px-8">
        <h2 id="faq-list-heading" class="sr-only">Listado de preguntas frecuentes</h2>

        <div class="space-y-4">
          {extendedFaq.map((item, index) => (
            <details class="group rounded-2xl border border-border/70 bg-navy-900/60 p-6 transition-all hover:border-cyan-500/40 [&_svg]:open:-rotate-180">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-text-primary">
                <span class="text-base md:text-lg">{item.question}</span>
                <svg
                  class="h-5 w-5 shrink-0 text-cyan-400 transition-transform duration-200"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <p class="mt-4 text-xs leading-relaxed text-text-secondary md:text-sm">
                {item.answer}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-navy-950 py-16 text-center">
      <div class="mx-auto max-w-3xl px-4">
        <h2 class="text-2xl font-bold text-text-primary md:text-3xl">
          ¿Tenés una duda que no aparece acá?
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-text-secondary">
          Escribinos al WhatsApp directo o completá nuestro formulario de contacto. Te asesoramos sin compromiso.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <CTAButton href="/contacto" variant="primary">
            Ir al formulario de contacto
          </CTAButton>
          <a
            href="https://wa.me/573185467155"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl border border-cyan-500 bg-transparent px-5 py-2.5 text-sm font-semibold text-cyan-400 transition-colors hover:bg-cyan-500/10"
          >
            <span>WhatsApp directo</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>
