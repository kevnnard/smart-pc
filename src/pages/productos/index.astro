---
/**
 * /productos — smart-pc Catálogo Técnico | Kinetic Performance.
 *
 * Public catalog route. Static SSG; the catalog is the single source of truth
 * (`ProductViewModel` driven), so the page never fabricates a price, URL,
 * stock value, image, or availability.
 *
 * Composition:
 *   1. <Navbar>             — global header (slot).
 *   2. Hero                 — eyebrow + title + body + DataStrip metrics.
 *   3. Notice strip         — Colombian COP price-variation caveat.
 *   4. <ProductInventory>   — 12-col sidebar + 3-col grid.
 *   5. Trust panel          — "Información transparente" + 3 feature cards.
 *   6. CTA panel            — Configurador link.
 *   7. Status breakdown     — verified / provisional / unconfirmed counts.
 *   8. <Footer>             — global footer (slot).
 */
import Footer from "../../components/footer/Footer.astro";
import Navbar from "../../components/navbar/Navbar.astro";
import ProductInventory from "../../components/products/ProductInventory.astro";
import CTAButton from "../../components/ui/CTAButton.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { catalog } from "../../lib/catalog/load-catalog";
import { PRICE_VARIATION_NOTICE } from "../../lib/money";
import { productViewModelsForCatalog } from "../../lib/products/catalog-view-model";

const products = productViewModelsForCatalog(catalog);

const verifiedCount = products.filter((p) => p.isVerified).length;
const provisionalCount = products.filter((p) => p.isProvisional).length;
const unconfirmedCount = products.filter((p) => p.isUnconfirmed).length;
const inStockCount = products.filter(
  (p) => p.stockStatus === "in-stock",
).length;
const limitedCount = products.filter((p) => p.stockStatus === "limited").length;
const totalCount = products.length;

const pageMeta = {
  title: "Productos | smart-pc",
  description:
    "Catálogo completo de componentes para tu PC. Precios observados en retailers colombianos con provenance verificable, sin inventar cifras.",
};

interface DataStripCell {
  readonly label: string;
  readonly value: string;
}

const dataStrip: readonly DataStripCell[] = [
  { label: "CATÁLOGO", value: `${totalCount} componentes` },
  { label: "TRANSPARENCIA", value: "Fuentes visibles" },
  { label: "REVISIÓN", value: "Compatibilidad" },
];
---

<BaseLayout {...pageMeta}>
  <Navbar slot="navbar" />

  <main>
    <!-- Hero with atmospheric cyan glow + Data Strip -->
    <section
      class="relative isolate overflow-hidden bg-navy-950 py-20 md:py-28"
      aria-labelledby="productos-hero-heading"
    >
      <div
        class="pointer-events-none absolute inset-0 -z-10 opacity-50"
        aria-hidden="true"
      >
        <div
          class="absolute -top-40 left-1/2 h-96 w-96 -translate-x-1/2 rounded-full bg-cyan-500/10 blur-3xl"
        >
        </div>
        <div
          class="absolute bottom-0 right-0 h-72 w-72 translate-x-1/4 rounded-full bg-blue-600/10 blur-3xl"
        >
        </div>
        <div
          class="absolute left-1/4 top-1/3 h-64 w-64 rounded-full bg-cyan-600/5 blur-3xl"
        >
        </div>
      </div>

      <div
        class="mx-auto flex w-full max-w-[1280px] flex-col items-center gap-6 px-4 text-center md:px-8"
      >
        <span
          class="font-mono text-xs tracking-widest text-cyan-400 md:text-sm"
        >
          CATÁLOGO TÉCNICO
        </span>
        <h1
          id="productos-hero-heading"
          class="text-4xl font-bold leading-tight tracking-tight text-text-primary md:text-6xl"
        >
          Catálogo Técnico
          <br />
          <span class="text-cyan-400">de Componentes</span>
        </h1>
        <div
          class="mt-2 h-1 w-24 rounded-full bg-gradient-to-r from-cyan-500 via-cyan-400 to-transparent md:mt-3 md:w-32"
          aria-hidden="true"
        >
        </div>
        <p
          class="max-w-2xl text-base leading-relaxed text-text-secondary md:text-lg"
        >
          Fuentes visibles para cada precio y fecha exacta de la consulta. Los
          precios pueden variar según vendedor, envío, impuestos y
          disponibilidad — siempre verificá antes de comprar.
        </p>

        <!-- Data Strip — three metric cells on dark navy -->
        <dl
          class="mt-8 grid w-full max-w-4xl grid-cols-1 gap-3 sm:grid-cols-3"
          data-data-strip
          aria-label="Métricas del catálogo"
        >
          {dataStrip.map((cell) => (
            <div
              class="rounded-2xl border border-border bg-navy-900/80 p-5 text-left"
            >
              <dt
                class="font-mono text-[10px] uppercase tracking-widest text-cyan-400"
              >
                {cell.label}
              </dt>
              <dd
                class="mt-1 font-mono text-2xl font-bold text-text-primary"
              >
                {cell.value}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Notice strip: Colombian COP variation caveat -->
    <section aria-label="Aviso de variación de precios" class="bg-navy-950 pb-4 pt-0">
      <div class="mx-auto w-full max-w-[1280px] px-4 md:px-8">
        <div class="flex items-start gap-3 rounded-xl border border-amber-400/20 bg-amber-400/5 px-4 py-3 text-xs text-amber-200/80">
          <svg
            class="mt-0.5 h-4 w-4 shrink-0 text-amber-400"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"
            />
          </svg>
          <p class="leading-relaxed">
            <span class="font-semibold text-amber-300">Aviso:</span>
            Los precios son observaciones en retailers colombianos. Pueden variar
            según vendedor, disponibilidad, envío, impuestos y fecha de consulta.
            Siempre verificá la fuente antes de comprar.
          </p>
        </div>
      </div>
    </section>

    <!-- Inventory: 12-col sidebar + 3-col main grid -->
    <section class="bg-navy-950 py-12">
      <div class="mx-auto w-full max-w-[1280px] px-4 md:px-8">
        <ProductInventory products={products} />
      </div>
    </section>

    <!-- Trust panel -->
    <section class="bg-navy-900/60 py-16" aria-labelledby="trust-heading">
      <div class="mx-auto w-full max-w-[1280px] px-4 md:px-8">
        <div class="mb-10 text-center">
          <p
            class="font-mono text-[10px] uppercase tracking-widest text-cyan-400"
          >
            COMPROMISO
          </p>
          <h2
            id="trust-heading"
            class="mt-2 text-2xl font-bold text-text-primary"
          >
            Información transparente
          </h2>
        </div>
        <dl
          class="grid grid-cols-1 gap-6 sm:grid-cols-3"
          aria-label="Pilares de transparencia"
        >
          <div
            class="rounded-2xl border border-border bg-navy-900 p-6"
          >
            <dt class="font-semibold text-text-primary">Precios observados</dt>
            <dd class="mt-2 text-sm leading-relaxed text-text-secondary">
              Cada precio proviene de una fuente real colombiana con fecha de
              verificación. No inventamos cifras.
            </dd>
          </div>
          <div
            class="rounded-2xl border border-border bg-navy-900 p-6"
          >
            <dt class="font-semibold text-text-primary">Fuente siempre visible</dt>
            <dd class="mt-2 text-sm leading-relaxed text-text-secondary">
              Cada tarjeta muestra el retailer, el estado de verificación y
              enlaza directamente a la oferta.
            </dd>
          </div>
          <div
            class="rounded-2xl border border-border bg-navy-900 p-6"
          >
            <dt class="font-semibold text-text-primary">Sin cargos ocultos</dt>
            <dd class="mt-2 text-sm leading-relaxed text-text-secondary">
              El servicio de armado ($150.000 COP) y el margen de operación se
              muestran separados en toda cotización.
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- CTA panel -->
    <section class="bg-navy-950 py-16" aria-labelledby="cta-heading">
      <div
        class="mx-auto flex w-full max-w-[1280px] flex-col items-center gap-6 px-4 text-center md:px-8"
      >
        <p
          class="font-mono text-[10px] uppercase tracking-widest text-cyan-400"
        >
          PRÓXIMO PASO
        </p>
        <h2
          id="cta-heading"
          class="text-2xl font-bold text-text-primary md:text-3xl"
        >
          ¿No sabés qué componentes elegir?
        </h2>
        <p class="max-w-xl text-sm leading-relaxed text-text-secondary">
          Usá el configurador interactivo para armar tu PC según uso y
          presupuesto. Calculamos la cotización completa con armado incluido.
        </p>
        <CTAButton href="/configurar" variant="primary">
          Abrir configurador
        </CTAButton>
      </div>
    </section>

    <!-- Status breakdown -->
    <section
      class="bg-navy-900/40 py-12"
      aria-labelledby="status-breakdown-heading"
    >
      <div class="mx-auto w-full max-w-[1280px] px-4 md:px-8">
        <h2
          id="status-breakdown-heading"
          class="mb-6 font-mono text-[10px] uppercase tracking-widest text-text-muted"
        >
          Estado del catálogo
        </h2>
        <dl
          class="grid grid-cols-2 gap-4 sm:grid-cols-4"
          aria-label="Resumen de estado de precios y stock"
        >
          <div class="rounded-xl border border-border bg-navy-900 p-4">
            <dt class="text-xs text-text-muted">Verificados</dt>
            <dd
              class="mt-1 font-mono text-2xl font-bold text-emerald-400"
            >
              {verifiedCount}
            </dd>
          </div>
          <div class="rounded-xl border border-border bg-navy-900 p-4">
            <dt class="text-xs text-text-muted">Provisionales</dt>
            <dd
              class="mt-1 font-mono text-2xl font-bold text-amber-400"
            >
              {provisionalCount}
            </dd>
          </div>
          <div class="rounded-xl border border-border bg-navy-900 p-4">
            <dt class="text-xs text-text-muted">Sin confirmar</dt>
            <dd class="mt-1 font-mono text-2xl font-bold text-text-muted">
              {unconfirmedCount}
            </dd>
          </div>
          <div class="rounded-xl border border-border bg-navy-900 p-4">
            <dt class="text-xs text-text-muted">En stock</dt>
            <dd
              class="mt-1 font-mono text-2xl font-bold text-cyan-400"
            >
              {inStockCount + limitedCount}
            </dd>
          </div>
        </dl>
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>
