---
import Footer from "../../components/footer/Footer.astro";
import Navbar from "../../components/navbar/Navbar.astro";
import CTAButton from "../../components/ui/CTAButton.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageMeta = {
  title: "Garantía Oficial y Soporte Técnico | smart-pc",
  description:
    "Cobertura técnica escrita por 24 meses en ensambles completos. Repuestos originales, tramitación local en Colombia y soporte directo sin intermediarios.",
};

const warrantyHighlights = [
  {
    icon: "📜",
    title: "24 meses de respaldo técnico",
    description:
      "Garantía por escrito sobre la mano de obra, ensamble, estabilidad eléctrica y diagnóstico técnico durante 2 años completos a partir de la fecha de entrega.",
  },
  {
    icon: "⚡",
    title: "Garantía oficial por fabricante",
    description:
      "Cada componente (procesador, placa, GPU, fuente, memoria, discos) conserva su garantía directa con la marca (desde 12 meses hasta 5 o 10 años en fuentes Gold y memorias).",
  },
  {
    icon: "🛠️",
    title: "Trámite de RMA gestionado por nosotros",
    description:
      "Si una pieza presenta defecto de fábrica, no te dejamos solo peleando con el fabricante o importador. Nosotros recibimos el equipo, diagnosticamos y gestionamos el reemplazo.",
  },
  {
    icon: "💬",
    title: "Asistencia técnica directa por WhatsApp",
    description:
      "Canal prioritario de atención de lunes a viernes (10:00 AM - 5:00 PM) para dudas de rendimiento, actualización de drivers o diagnósticos remotos sin costo adicional.",
  },
];
---

<BaseLayout {...pageMeta}>
  <Navbar slot="navbar" />

  <main>
    <!-- Hero -->
    <section class="relative isolate overflow-hidden bg-navy-950 pb-12 pt-20 md:pt-28">
      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <div class="absolute -top-32 left-1/2 h-[450px] w-[650px] -translate-x-1/2 rounded-full bg-cyan-500/10 blur-3xl"></div>
        <div class="absolute right-0 top-1/4 h-72 w-72 translate-x-1/3 rounded-full bg-blue-600/10 blur-3xl"></div>
      </div>

      <div class="mx-auto flex w-full max-w-[1280px] flex-col items-center gap-6 px-4 text-center md:px-8">
        <div class="flex items-center gap-2 rounded-full border border-cyan-500/20 bg-cyan-500/8 px-4 py-1.5 shadow-sm">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-cyan-400"></span>
          <span class="font-mono text-[11px] font-semibold uppercase tracking-widest text-cyan-400">Tranquilidad Total</span>
        </div>

        <h1 class="text-4xl font-bold tracking-tight text-text-primary md:text-6xl">
          Garantía real de 24 meses.<br />
          <span class="bg-gradient-to-r from-cyan-400 via-cyan-300 to-blue-400 bg-clip-text text-transparent">
            Respaldamos cada máquina que sale del taller.
          </span>
        </h1>

        <p class="max-w-2xl text-base leading-relaxed text-text-secondary md:text-lg">
          No te dejamos solo con un manual en inglés. Nuestro compromiso técnico te acompaña durante toda la vida útil de tu computador.
        </p>
      </div>
    </section>

    <!-- Pilares de garantía -->
    <section class="border-y border-border/60 bg-navy-900/40 py-16" aria-labelledby="highlights-heading">
      <div class="mx-auto w-full max-w-[1280px] px-4 md:px-8">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          {warrantyHighlights.map((w) => (
            <div class="flex gap-5 rounded-2xl border border-border/70 bg-navy-900/60 p-7 shadow-sm transition-colors hover:border-cyan-500/40 hover:bg-navy-900">
              <div class="text-3xl shrink-0" aria-hidden="true">{w.icon}</div>
              <div>
                <h3 class="text-lg font-bold text-text-primary">{w.title}</h3>
                <p class="mt-2 text-xs leading-relaxed text-text-secondary md:text-sm">{w.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Términos claros de qué cubre y qué no -->
    <section class="bg-navy-950 py-20" aria-labelledby="coverage-heading">
      <div class="mx-auto max-w-4xl px-4">
        <h2 id="coverage-heading" class="text-2xl font-bold text-text-primary mb-10 text-center md:text-3xl">
          Términos transparentes de cobertura
        </h2>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          <!-- Qué SÍ cubre -->
          <div class="rounded-2xl border border-emerald-500/30 bg-emerald-500/5 p-6 md:p-8">
            <h3 class="flex items-center gap-2 text-base font-bold text-emerald-300">
              <span>✓</span>
              <span>Qué SÍ cubre nuestra garantía</span>
            </h3>
            <ul class="mt-4 space-y-2.5 text-xs text-text-secondary leading-relaxed">
              <li>• Defectos de fábrica en cualquier componente instalado (procesador, placa, GPU, memorias, disco, fuente).</li>
              <li>• Fallas de estabilidad térmica derivadas del ensamble o aplicación de pasta térmica.</li>
              <li>• Desprendimientos o fallas en el cable management o conexión interna.</li>
              <li>• Asistencia para actualizaciones de BIOS y perfiles de memoria estables.</li>
              <li>• Diagnóstico técnico gratuito en taller durante todo el período de cobertura.</li>
            </ul>
          </div>

          <!-- Qué NO cubre -->
          <div class="rounded-2xl border border-rose-500/30 bg-rose-500/5 p-6 md:p-8">
            <h3 class="flex items-center gap-2 text-base font-bold text-rose-300">
              <span>✕</span>
              <span>Qué NO cubre la garantía</span>
            </h3>
            <ul class="mt-4 space-y-2.5 text-xs text-text-secondary leading-relaxed">
              <li>• Daños causados por sobrecargas eléctricas externas o fluctuaciones severas sin regulador o UPS adecuada.</li>
              <li>• Manipulación indebida, golpes, caídas o derrames de líquidos sobre el equipo.</li>
              <li>• Overclocking extremo de voltajes fuera de los perfiles recomendados por fabricante.</li>
              <li>• Infecciones de malware, virus o problemas exclusivos del sistema operativo instalado por el usuario.</li>
              <li>• Retiro o alteración de sellos y números de serie de los componentes.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Proceso de reclamación -->
    <section class="border-t border-border/60 bg-navy-900/30 py-16">
      <div class="mx-auto max-w-4xl px-4">
        <h2 class="text-xl font-bold text-text-primary text-center mb-6">
          ¿Cómo solicitar servicio por garantía?
        </h2>
        <div class="rounded-2xl border border-border bg-navy-900/60 p-6 text-xs text-text-secondary leading-relaxed space-y-3 md:text-sm">
          <p>
            1. Escribinos a nuestro WhatsApp oficial <strong>+57 318 546 7155</strong> o al correo <strong>smart-pc@kevnard.com</strong> con el número de tu orden y una descripción clara de la novedad.
          </p>
          <p>
            2. Realizamos una sesión de descarte técnico preliminar (videollamada o guía de diagnóstico) para verificar si es un ajuste de software, cable de monitor o configuración de BIOS.
          </p>
          <p>
            3. Si se confirma falla de hardware, coordinamos la recepción del equipo en Bogotá o el envío asegurado desde cualquier ciudad. Te mantenemos informado en cada etapa del diagnóstico y recambio.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="border-t border-border/60 bg-navy-950 py-14 text-center">
      <div class="mx-auto max-w-3xl px-4">
        <h2 class="text-xl font-bold text-text-primary md:text-2xl">
          ¿Tenés alguna consulta técnica o querés reportar un caso?
        </h2>
        <div class="mt-6 flex justify-center">
          <CTAButton href="/contacto" variant="primary">
            Contactar al área de soporte técnico
          </CTAButton>
        </div>
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>
