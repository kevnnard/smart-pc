---
import ContactForm from "../../components/contact/ContactForm";
import Footer from "../../components/footer/Footer.astro";
import Navbar from "../../components/navbar/Navbar.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageMeta = {
  title: "Contacto | smart-pc",
  description:
    "Escribinos directamente a smart-pc@kevnard.com o por WhatsApp al +57 318 546 7155. Cotizaciones y asesoría en Colombia.",
};

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_FORM_ID;
---

<BaseLayout {...pageMeta}>
  <Navbar slot="navbar" />

  <main>
    <!-- Hero compacto enfocado directamente a la acción -->
    <section class="relative isolate overflow-hidden bg-navy-950 pb-8 pt-16 md:pt-20">
      <!-- Glow ambiental sutil -->
      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <div class="absolute -top-24 left-1/2 h-64 w-[600px] -translate-x-1/2 rounded-full bg-cyan-500/10 blur-3xl"></div>
      </div>

      <div class="mx-auto flex w-full max-w-[1280px] flex-col items-center gap-4 px-4 text-center md:px-8">
        <!-- Eyebrow Pill sin // -->
        <div class="flex items-center gap-2 rounded-full border border-cyan-500/20 bg-cyan-500/8 px-3.5 py-1 shadow-sm">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-cyan-400"></span>
          <span class="font-mono text-[11px] uppercase tracking-widest text-cyan-400 font-semibold">Atención técnica directa</span>
        </div>

        <h1 class="text-3xl font-bold tracking-tight text-text-primary md:text-5xl">
          ¿En qué te podemos ayudar hoy?
        </h1>
        <p class="max-w-xl text-sm leading-relaxed text-text-secondary md:text-base">
          Dejanos tu consulta o especificación de armado. Respondemos en menos de 24 horas hábiles o escribinos al WhatsApp directo.
        </p>
      </div>
    </section>

    <!-- Main Grid: Formulario + Datos de contacto -->
    <section class="bg-navy-950 pb-20 pt-4">
      <div class="mx-auto max-w-[1280px] px-4 md:px-8">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-start">
          <!-- Form (7 cols) -->
          <div class="rounded-2xl border border-border bg-navy-900/60 p-6 md:p-8 shadow-sm lg:col-span-7">
            <div class="mb-6">
              <span class="font-mono text-[10px] uppercase tracking-widest text-cyan-400 font-bold">FORMULARIO</span>
              <h2 class="mt-1 text-xl font-bold text-text-primary">
                Envianos un mensaje
              </h2>
              <p class="mt-1 text-xs text-text-muted">
                Completá los datos y te enviamos la cotización o respuesta técnica a tu correo.
              </p>
            </div>
            <ContactForm formspreeId={formspreeId} client:load />
          </div>

          <!-- Info & WhatsApp Box (5 cols) -->
          <div class="space-y-6 lg:col-span-5">
            <!-- Box destacado de WhatsApp -->
            <div class="rounded-2xl border border-emerald-500/30 bg-gradient-to-br from-navy-900 to-navy-950 p-6 shadow-lg shadow-emerald-500/5">
              <div class="flex items-center gap-2 mb-2">
                <span class="inline-flex h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="font-mono text-[10px] uppercase tracking-widest text-emerald-400 font-bold">Canal prioritario</span>
              </div>
              <h3 class="text-lg font-bold text-text-primary">
                WhatsApp directo
              </h3>
              <p class="mt-1.5 text-xs text-text-secondary leading-relaxed">
                La forma más rápida de obtener asesoría personalizada y cotizaciones en vivo con nuestros técnicos.
              </p>

              <div class="mt-4 flex items-center justify-between gap-4 pt-2 border-t border-border/60">
                <div class="font-mono text-sm font-bold text-text-primary">
                  +57 318 546 7155
                </div>
                <a
                  href="https://wa.me/573185467155"
                  rel="noopener noreferrer"
                  target="_blank"
                  class="inline-flex items-center gap-2 rounded-xl bg-[#25D366] px-4 py-2 text-xs font-bold text-white shadow-md transition-all hover:brightness-110"
                >
                  <span>Abrir chat</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>

            <!-- Datos directos de contacto -->
            <div class="rounded-2xl border border-border bg-navy-900/40 p-6 space-y-4 text-xs">
              <div>
                <p class="font-mono text-[10px] uppercase tracking-wider text-text-muted">Correo electrónico oficial</p>
                <a
                  href="mailto:smart-pc@kevnard.com"
                  class="mt-1 inline-block font-semibold text-cyan-400 hover:text-cyan-300 hover:underline"
                >
                  smart-pc@kevnard.com
                </a>
              </div>

              <div class="pt-3 border-t border-border/50">
                <p class="font-mono text-[10px] uppercase tracking-wider text-text-muted">Horario de atención</p>
                <p class="mt-1 text-text-primary font-semibold">Lunes a viernes: 10:00 AM – 5:00 PM</p>
                <p class="mt-0.5 text-text-muted text-[11px]">No atendemos fines de semana ni festivos.</p>
              </div>

              <div class="pt-3 border-t border-border/50">
                <p class="font-mono text-[10px] uppercase tracking-wider text-text-muted">Modalidad de entrega y despachos</p>
                <p class="mt-1 text-text-primary font-semibold">Entregas en persona únicamente en Bogotá.</p>
                <p class="mt-0.5 text-text-secondary leading-relaxed">
                  Para el resto de Colombia: envíos 100% asegurados a nivel nacional o despachamos por la transportadora de tu preferencia.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  document.addEventListener('click', (e) => {
    const nav = document.getElementById('main-nav');
    const toggle = document.getElementById('nav-toggle');
    if (nav && toggle) {
      if (toggle.contains(e.target)) nav.classList.toggle('hidden');
      else if (!nav.contains(e.target) && !nav.classList.contains('hidden')) nav.classList.add('hidden');
    }
  });
</script>
