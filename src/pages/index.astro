---
import Footer from "../components/footer/Footer.astro";
import ConfiguratorCTA from "../components/home/ConfiguratorCTA.astro";
import PageHero from "../components/home/PageHero.astro";
import PrebuildTeaser from "../components/home/PrebuildTeaser.astro";
import ServicesGrid from "../components/home/ServicesGrid.astro";
import Navbar from "../components/navbar/Navbar.astro";
import FAQItem from "../components/ui/FAQItem.astro";
import StatsStrip from "../components/ui/StatsStrip.astro";
/**
 * Home page (/) — smart-pc.
 *
 * Composes the full marketing surface from the Phase 4 reusable components:
 *   1. <Navbar>             — global header (slot in BaseLayout).
 *   2. <PageHero>           — eyebrow + H1 + accent + body + primary/outline CTAs.
 *   3. <StatsStrip>         — 4-cell stats row sourced from `src/data/home.ts`.
 *   4. <ServicesGrid>       — 2×2 grid of services sourced from `src/data/services.ts`.
 *   5. <PrebuildTeaser>     — 3-up prebuild tier grid sourced from `src/data/prebuilds.ts`.
 *   6. <ConfiguratorCTA>    — two-column split with a static GPU-selection preview.
 *   7. FAQ accordion        — composed from `FAQItem`s, sourced from `src/data/home.ts`.
 *   8. Contact teaser       — minimal WhatsApp + email CTA section (static markup).
 *   9. <Footer>             — global footer (slot in BaseLayout).
 *
 * The inline `<script>` at the bottom is a defensive fallback for a future
 * <Navbar> variant exposing `id="main-nav"` + `id="nav-toggle"`. The active
 * Navbar uses `id="mobile-menu-toggle"` + `id="mobile-menu"` and ships its own
 * toggle inline; the fallback is a no-op while that variant is in production.
 */
import { faq, stats } from "../data/home";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <Navbar slot="navbar" />

  <PageHero
    eyebrow="// CUSTOM PC BUILDER · COLOMBIA"
    title="Armamos la PC"
    accent="de tus sueños"
    body="Desde creators hasta gamers — ensamble profesional, garantía real y precios transparentes en COP."
    primaryHref="/configurar"
    primaryLabel="Armar mi PC"
    outlineHref="/pre-armadas"
    outlineLabel="Ver pre-armadas"
    align="left"
  />

  <StatsStrip items={stats} />

  <ServicesGrid />

  <PrebuildTeaser />

  <ConfiguratorCTA />

  <section
    class="w-full bg-navy-900 py-16 md:py-24"
    aria-labelledby="faq-heading"
  >
    <div
      class="mx-auto flex w-full max-w-[1280px] flex-col gap-10 px-4 md:px-8"
    >
      <header class="flex flex-col gap-4 text-center md:text-left">
        <span class="font-mono text-xs tracking-widest text-cyan-500 md:text-sm">
          // FAQ
        </span>
        <h2
          id="faq-heading"
          class="text-3xl font-bold leading-tight text-text-primary md:text-4xl"
        >
          Preguntas frecuentes
        </h2>
        <p class="max-w-2xl text-base leading-relaxed text-text-secondary">
          Todo lo que necesitás saber antes de armar tu próxima PC.
        </p>
      </header>

      <div class="mx-auto flex w-full max-w-3xl flex-col gap-3">
        {faq.map((item, index) => <FAQItem item={item} index={index} />)}
      </div>
    </div>
  </section>

  <section class="bg-navy-950 py-20" aria-labelledby="contact-teaser-heading">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <h2
        id="contact-teaser-heading"
        class="mb-4 text-3xl font-bold text-text-primary md:text-4xl"
      >
        ¿Listo para tu próxima PC?
      </h2>
      <p class="mb-8 text-base leading-relaxed text-text-secondary md:text-lg">
        Escríbenos por WhatsApp o correo. Te respondemos en menos de 24 horas.
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="https://wa.me/573185467155"
          rel="noopener noreferrer"
          target="_blank"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-cyan-500 px-8 py-3.5 font-bold text-navy-950 shadow-[0_8px_24px_-12px_rgba(34,211,238,0.6)] transition-all duration-150 hover:bg-cyan-400 hover:shadow-[0_12px_28px_-12px_rgba(34,211,238,0.8)] active:translate-y-px"
        >
          <svg
            class="h-5 w-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
            />
          </svg>
          WhatsApp
        </a>
        <a
          href="mailto:smart-pc@kevnard.com"
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-border bg-transparent px-8 py-3.5 font-semibold text-text-primary transition-colors duration-150 hover:border-cyan-500 hover:text-cyan-500"
        >
          smart-pc@kevnard.com
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  document.addEventListener('click', (e) => {
    const nav = document.getElementById('main-nav');
    const toggle = document.getElementById('nav-toggle');
    if (nav && toggle) {
      if (toggle.contains(e.target)) { nav.classList.toggle('hidden'); }
      else if (!nav.contains(e.target) && !nav.classList.contains('hidden')) { nav.classList.add('hidden'); }
    }
  });
</script>
