---
import Footer from "../../components/footer/Footer.astro";
import Navbar from "../../components/navbar/Navbar.astro";
import CTAButton from "../../components/ui/CTAButton.astro";
import PricingCard from "../../components/ui/PricingCard.astro";
import { prebuilds } from "../../data/prebuilds";
/**
 * Pre-armadas catalog page (/pre-armadas) — smart-pc.
 *
 * F2.1 — List all curated builds. Iterates `src/data/prebuilds.ts` and renders
 * one `PricingCard` per prebuild in a 1 / 2 / 3-column responsive grid. Each
 * card's `featured` flag drives the cyan glow treatment on `PricingCard`.
 *
 * Composition:
 *   1. <Navbar>             — global header (slot).
 *   2. Hero                 — eyebrow + H1 + body + outline CTA to /configurar.
 *   3. Catalog grid         — three `PricingCard`s from `prebuilds.ts`.
 *   4. Comparison note      — small cross-link to /configurar for visitors who
 *                              need a custom build (F2.1 bottom-of-page CTA).
 *   5. <Footer>             — global footer (slot).
 *
 * Pricing: `PricingCard` already formats `prebuild.basePrice` through
 * `Intl.NumberFormat('es-CO')` (whole pesos). No extra wrapper is needed here.
 *
 * Each `PricingCard`'s "Ver configuración" CTA links to `/pre-armadas/{slug}`
 * — the detail route is implemented in `[slug].astro` (Task 6.2).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageMeta = {
  title: "PC Pre-armadas | smart-pc",
  description:
    "PCs pre-configuradas para creators, gamers y profesionales. Ensamblaje profesional, garantía 24 meses y precios transparentes.",
};
---

<BaseLayout {...pageMeta}>
  <Navbar slot="navbar" />

  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-navy-950 pb-0 pt-24 md:pt-32">
    <!-- Atmospheric glows -->
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute -top-32 left-1/2 h-[500px] w-[700px] -translate-x-1/2 rounded-full bg-cyan-500/8 blur-3xl"></div>
      <div class="absolute right-0 top-1/4 h-72 w-72 translate-x-1/3 rounded-full bg-blue-600/10 blur-3xl"></div>
      <div class="absolute bottom-0 left-1/4 h-64 w-64 rounded-full bg-cyan-600/5 blur-3xl"></div>
    </div>

    <div class="mx-auto flex w-full max-w-[1280px] flex-col items-center gap-8 px-4 text-center md:px-8">
      <!-- Eyebrow pill -->
      <div class="flex items-center gap-2 rounded-full border border-cyan-500/20 bg-cyan-500/8 px-4 py-1.5">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-cyan-400"></span>
        <span class="font-mono text-[11px] uppercase tracking-widest text-cyan-400">Listas para encender</span>
      </div>

      <!-- Headline -->
      <div class="space-y-4">
        <h1 class="text-5xl font-bold leading-tight tracking-tight text-text-primary md:text-7xl">
          PCs armadas.<br />
          <span class="bg-gradient-to-r from-cyan-400 via-cyan-300 to-blue-400 bg-clip-text text-transparent">
            Sin dolores de cabeza.
          </span>
        </h1>
        <div class="mx-auto h-px w-32 bg-gradient-to-r from-transparent via-cyan-500/60 to-transparent"></div>
      </div>

      <!-- Body -->
      <p class="max-w-2xl text-base leading-relaxed text-text-secondary md:text-lg">
        Tres configuraciones probadas para creadores, gamers y equipos que necesitan
        potencia real. Ensamblaje profesional,
        <strong class="font-semibold text-text-primary">garantía 24 meses</strong>
        y componentes con
        <strong class="font-semibold text-text-primary">fuentes verificadas</strong>.
      </p>

      <!-- Social proof strip -->
      <ul class="flex flex-wrap items-center justify-center gap-6 text-xs text-text-muted" role="list" aria-label="Garantías incluidas">
        {[
          "Ensamblaje profesional incluido",
          "Garantía 24 meses",
          "Precios transparentes en COP",
          "Soporte técnico post-venta",
        ].map((item) => (
          <li class="flex items-center gap-2">
            <svg class="h-4 w-4 shrink-0 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>

      <!-- CTAs -->
      <div class="flex flex-col items-center gap-3 sm:flex-row">
        <a
          href="#catalogo"
          class="rounded-xl bg-gradient-to-r from-cyan-500 to-cyan-400 px-7 py-3 text-sm font-bold text-navy-950 shadow-lg shadow-cyan-500/25 transition-all hover:brightness-110 hover:shadow-cyan-500/40"
        >
          Ver configuraciones
        </a>
        <CTAButton href="/configurar" variant="outline">
          Armá la tuya a medida →
        </CTAButton>
      </div>

      <!-- Divider into cards -->
      <div class="mt-6 w-full">
        <div class="h-px w-full bg-gradient-to-r from-transparent via-border/60 to-transparent"></div>
      </div>
    </div>
  </section>

  <!-- Catalog grid -->
  <section class="bg-navy-950 py-16">
    <div class="mx-auto max-w-7xl px-4">
      <div class="grid gap-8 md:grid-cols-3">
        {
          prebuilds.map((prebuild) => (
            <PricingCard prebuild={prebuild} featured={prebuild.featured} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Comparison cross-link -->
  <section class="bg-navy-950 py-12">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <p class="text-text-secondary">
        ¿Necesitás algo diferente? Usá nuestro{" "}
        <a href="/configurar" class="text-cyan-500 hover:underline">
          configurador
        </a>{" "}
        para armar tu PC a medida.
      </p>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  document.addEventListener('click', (e) => {
    const nav = document.getElementById('main-nav');
    const toggle = document.getElementById('nav-toggle');
    if (nav && toggle) {
      if (toggle.contains(e.target)) { nav.classList.toggle('hidden'); }
      else if (!nav.contains(e.target) && !nav.classList.contains('hidden')) { nav.classList.add('hidden'); }
    }
  });
</script>
