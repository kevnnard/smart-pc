---
import Footer from "../../components/footer/Footer.astro";
import Navbar from "../../components/navbar/Navbar.astro";
import CTAButton from "../../components/ui/CTAButton.astro";
import SpecList from "../../components/ui/SpecList.astro";
import { prebuilds } from "../../data/prebuilds";
import type { PrebuiltPC } from "../../data/types";
/**
 * Pre-armada detail page (/pre-armadas/[slug]) — smart-pc.
 *
 * F3 · Build detail. `getStaticPaths()` returns one static route per entry in
 * `src/data/prebuilds.ts`. A request for an unknown slug falls through to
 * Astro's default 404.
 *
 * Composition:
 *   1. <Navbar>             — global header (slot).
 *   2. Header               — back link, badge, name, tagline, large price tag.
 *   3. Specs                — `SpecList` rendering `prebuild.components`.
 *   4. Breakdown            — Quote breakdown line items (PR 2).
 *   5. Add-ons (optional)   — Complementos opcionales (monitores, periféricos) cotizados aparte.
 *   6. Tail trust strip     — Garantías y ensamblaje profesional.
 *   7. <Footer>             — global footer (slot).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { catalog } from "../../lib/catalog/load-catalog";
import { formatCop, PRICE_VARIATION_NOTICE } from "../../lib/money";
import { calculateQuote } from "../../lib/quotes/calculate-quote";

export function getStaticPaths() {
  return prebuilds.map((prebuild) => ({
    params: { slug: prebuild.slug },
    props: { prebuild },
  }));
}

interface Props {
  prebuild: PrebuiltPC;
}

const { prebuild } = Astro.props;

const catalogPrebuild = catalog.byPrebuildSlug.get(prebuild.slug);
const quote = catalogPrebuild
  ? calculateQuote(
      {
        componentIds: catalogPrebuild.componentIds,
        serviceId: catalogPrebuild.serviceId,
        pricingPolicyId: catalogPrebuild.pricingPolicyId,
      },
      catalog,
      new Date(),
    )
  : null;
const breakdown = quote?.ok ? quote.quote.lines : null;

const pageMeta = {
  title: `${prebuild.name} | smart-pc`,
  description: prebuild.tagline,
};
---

<BaseLayout {...pageMeta}>
  <Navbar slot="navbar" />

  <!-- Compact build hero -->
  <section class="relative isolate overflow-hidden bg-navy-950 pb-10 pt-20 md:pt-24">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute -top-24 left-1/2 h-72 w-[600px] -translate-x-1/2 rounded-full bg-cyan-500/10 blur-3xl"></div>
    </div>

    <div class="mx-auto flex w-full max-w-[1280px] flex-col gap-6 px-4 md:px-8">
      <!-- Top row: back link + featured badge -->
      <div class="flex items-center justify-between gap-3">
        <a
          href="/pre-armadas"
          class="group inline-flex items-center gap-2 rounded-lg border border-border/60 bg-navy-900/60 px-3 py-1.5 text-xs font-medium text-text-secondary transition-all hover:border-cyan-500/40 hover:bg-navy-800 hover:text-cyan-300"
        >
          <svg class="h-3.5 w-3.5 transition-transform group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          Volver a pre-armadas
        </a>

        {prebuild.featured && (
          <span class="inline-flex items-center gap-1.5 rounded-full bg-cyan-500/15 px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-cyan-300 ring-1 ring-cyan-400/40">
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2l2.39 6.96h7.27l-5.88 4.27 2.24 6.91L12 16.27 5.98 20.14l2.24-6.91L2.34 8.96h7.27L12 2z" />
            </svg>
            Destacado
          </span>
        )}
      </div>

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
        <!-- Left: identity -->
        <div class="space-y-3">
          <h1 class="text-4xl font-bold leading-tight tracking-tight text-text-primary md:text-5xl">
            {prebuild.name}
          </h1>
          <p class="max-w-2xl text-base text-text-secondary md:text-lg">{prebuild.tagline}</p>
          {prebuild.badge && (
            <span class="inline-block rounded-md border border-cyan-500/30 bg-cyan-500/5 px-2.5 py-1 text-[11px] font-mono uppercase tracking-widest text-cyan-400">
              {prebuild.badge}
            </span>
          )}
        </div>

        <!-- Right: Price block, compact -->
        <div class="rounded-2xl border border-cyan-500/30 bg-gradient-to-br from-navy-900 to-navy-950 p-5 shadow-lg shadow-cyan-500/10 lg:min-w-[280px]">
          {prebuild.basePrice === null ? (
            <>
              <div class="font-mono text-[10px] uppercase tracking-widest text-amber-400">Cotización</div>
              <div class="mt-2 text-xl font-bold text-amber-300">Pendiente</div>
              <div class="mt-1 text-xs text-text-muted">Componentes sin precio exacto confirmado.</div>
            </>
          ) : (
            <>
              <div class="font-mono text-[10px] uppercase tracking-widest text-cyan-400">Precio final</div>
              <div class="mt-2 font-mono text-3xl font-bold text-cyan-300">{formatCop(prebuild.basePrice)}</div>
              <div class="mt-1 flex items-center gap-1.5 text-xs text-text-muted">
                <svg class="h-3 w-3 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>IVA incluido · COP</span>
              </div>
            </>
          )}

          <div class="mt-4 flex flex-col gap-2">
            <a
              href="https://wa.me/573185467155"
              rel="noopener noreferrer"
              target="_blank"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-cyan-500 to-cyan-400 px-5 py-2.5 text-sm font-bold text-navy-950 shadow-md shadow-cyan-500/20 transition-all hover:brightness-110"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.002-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488" />
              </svg>
              Consultar por WhatsApp
            </a>
            <CTAButton href="/configurar" variant="outline">
              Personalizar
            </CTAButton>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Spec list -->
  <section class="bg-navy-950 py-12">
    <div class="mx-auto max-w-4xl px-4">
      <h2 class="mb-6 text-xl font-semibold text-text-primary">
        Componentes incluidos
      </h2>
      <SpecList components={prebuild.components} variant="list" />
      {
        prebuild.basePrice === null && (
          <p class="mt-4 text-xs text-amber-400">
            Esta configuración incluye componentes con precio no
            confirmado. Te contactaremos por WhatsApp para confirmar
            antes de cotizar.
          </p>
        )
      }
    </div>
  </section>

  <!-- Quote breakdown (PR 2) -->
  {
    breakdown && (
      <section class="bg-navy-950 py-12">
        <div class="mx-auto max-w-4xl px-4">
          <h2 class="mb-6 text-xl font-semibold text-text-primary">
            Desglose del precio (COP)
          </h2>
          <div class="overflow-hidden rounded-2xl border border-border bg-navy-900">
            <table class="w-full text-left text-sm">
              <thead class="bg-navy-800 text-text-muted">
                <tr>
                  <th class="px-4 py-3 font-mono text-xs uppercase tracking-wider">
                    Concepto
                  </th>
                  <th class="px-4 py-3 text-right font-mono text-xs uppercase tracking-wider">
                    Importe
                  </th>
                </tr>
              </thead>
              <tbody>
                {(() => {
                  const compLine = breakdown.find((l) => l.kind === "components");
                  const srvLine = breakdown.find((l) => l.kind === "service");
                  const pctLine = breakdown.find((l) => l.kind === "percentage-margin");
                  const totLine = breakdown.find((l) => l.kind === "total");

                  const totalServiceAndAssembly = (srvLine?.amountCop ?? 0) + (pctLine?.amountCop ?? 0);
                  const rateStr = pctLine?.rate !== undefined ? ` (${pctLine.rate}%)` : "";

                  return (
                    <>
                      {compLine && (
                        <tr class="border-t border-border">
                          <td class="px-4 py-3 text-text-primary">
                            Subtotal de componentes
                          </td>
                          <td class="px-4 py-3 text-right font-mono text-cyan-500">
                            {formatCop(compLine.amountCop)}
                          </td>
                        </tr>
                      )}
                      <tr class="border-t border-border">
                        <td class="px-4 py-3 text-text-primary">
                          Servicio de ensamble, garantía y optimización ($150.000 + {pctLine?.rate ?? 0}%)
                        </td>
                        <td class="px-4 py-3 text-right font-mono text-cyan-500">
                          {formatCop(totalServiceAndAssembly)}
                        </td>
                      </tr>
                      {totLine && (
                        <tr class="border-t border-border bg-navy-800 font-semibold">
                          <td class="px-4 py-3 text-text-primary">
                            Total (COP)
                          </td>
                          <td class="px-4 py-3 text-right font-mono text-cyan-500 text-lg">
                            {formatCop(totLine.amountCop)}
                          </td>
                        </tr>
                      )}
                    </>
                  );
                })()}
              </tbody>
            </table>
          </div>
          <p class="mt-4 text-xs text-text-muted">{PRICE_VARIATION_NOTICE}</p>
        </div>
      </section>
    )
  }

  <!-- Add-ons opcionales (no impactan el total del build) -->
  {
    prebuild.addOns && prebuild.addOns.length > 0 && (
      <section class="bg-navy-950 pt-2 pb-12">
        <div class="mx-auto max-w-4xl px-4">
          <div class="rounded-2xl border border-cyan-500/25 bg-navy-900/60 p-6 shadow-sm">
            <div class="mb-1 flex items-center gap-2">
              <span class="font-mono text-[10px] uppercase tracking-widest text-cyan-400 font-bold">
                ADICIONALES OPCIONALES
              </span>
              <span class="text-[11px] text-text-muted">· No incluidos en el precio base</span>
            </div>
            <h3 class="text-lg font-bold text-text-primary">
              Complementá tu equipo
            </h3>
            <p class="mt-1 text-xs text-text-secondary leading-relaxed">
              Monitores y periféricos compatibles para dejar tu estación lista. Se cotizan por separado según tu necesidad.
            </p>

            <ul class="mt-4 grid grid-cols-1 gap-2.5 sm:grid-cols-2" role="list" aria-label="Adicionales opcionales">
              {prebuild.addOns.map((addon) => {
                const catalogComp = catalog.byComponentId.get(addon.id);
                const title = catalogComp?.model ?? addon.id;
                const typeLabel = addon.type === "monitor"
                  ? "Monitor"
                  : addon.type === "keyboard+mouse"
                    ? "Kit teclado + ratón"
                    : "Accesorio";

                return (
                  <li class="flex items-center justify-between gap-3 rounded-xl border border-border/70 bg-navy-950/70 p-3.5 transition-colors hover:border-cyan-500/40">
                    <div class="min-w-0 flex-1">
                      <span class="inline-block rounded bg-cyan-500/10 px-1.5 py-0.5 font-mono text-[9px] font-bold uppercase tracking-wider text-cyan-400 mb-1">
                        {typeLabel}
                      </span>
                      <p class="font-semibold text-xs text-text-primary truncate" title={title}>
                        {title}
                      </p>
                    </div>
                    <div class="shrink-0 text-right">
                      <p class="font-mono text-xs font-bold text-cyan-300">
                        {formatCop(addon.priceCop)}
                      </p>
                      <a
                        href={addon.url}
                        rel="noopener noreferrer"
                        target="_blank"
                        class="inline-flex items-center gap-0.5 text-[10px] text-text-muted hover:text-cyan-400 underline underline-offset-2 transition-colors"
                      >
                        <span>Ver oferta</span>
                        <span aria-hidden="true">↗</span>
                      </a>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        </div>
      </section>
    )
  }

  <!-- Tail trust strip -->
  <section class="bg-navy-900/40 py-10">
    <div class="mx-auto flex w-full max-w-[1280px] flex-wrap items-center justify-center gap-x-8 gap-y-3 px-4 text-xs text-text-muted md:px-8" role="list" aria-label="Garantías de la pre-armada">
      {[
        "Ensamblaje profesional",
        "Garantía 24 meses",
        "Precios transparentes",
        "Soporte post-venta",
      ].map((label) => (
        <div class="flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>{label}</span>
        </div>
      ))}
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  document.addEventListener('click', (e) => {
    const nav = document.getElementById('main-nav');
    const toggle = document.getElementById('nav-toggle');
    if (nav && toggle) {
      if (toggle.contains(e.target)) { nav.classList.toggle('hidden'); }
      else if (!nav.contains(e.target) && !nav.classList.contains('hidden')) { nav.classList.add('hidden'); }
    }
  });
</script>
