---
import Footer from "../../components/footer/Footer.astro";
import Navbar from "../../components/navbar/Navbar.astro";
import CTAButton from "../../components/ui/CTAButton.astro";
import SpecList from "../../components/ui/SpecList.astro";
import { prebuilds } from "../../data/prebuilds";
import type { PrebuiltPC } from "../../data/types";
/**
 * Pre-armada detail page (/pre-armadas/[slug]) — smart-pc.
 *
 * F3 · Build detail. `getStaticPaths()` returns one static route per entry in
 * `src/data/prebuilds.ts`. A request for an unknown slug falls through to
 * Astro's default 404 (Astro 7 raises `404 Not found` when `getStaticPaths` does
 * not match).
 *
 * Composition:
 *   1. <Navbar>             — global header (slot).
 *   2. Header               — back link, badge, name, tagline, large price tag.
 *   3. Specs                — `SpecList` rendering `prebuild.components` in the
 *                              default "list" variant (F3.4).
 *   4. Breakdown            — Quote breakdown line items (PR 2): components,
 *                              service, fixed margin, percentage margin,
 *                              total margin, final total.
 *   5. CTA                  — WhatsApp anchor (`wa.me/573001234567`, line 147 of
 *                              spec.md) + outline CTA to /configurar so the
 *                              visitor can keep iterating on a custom build.
 *   6. <Footer>             — global footer (slot).
 *
 * Pricing notes (post PR 2):
 *   - `prebuild.basePrice` is the derived final customer price in whole COP,
 *     computed by the quote engine from referenced components + confirmed
 *     service + disclosed margin (see `src/data/components.ts` /
 *     `src/lib/quotes/calculate-quote.ts`). Rendered via `formatCop()`.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { catalog } from "../../lib/catalog/load-catalog";
import { formatCop, PRICE_VARIATION_NOTICE } from "../../lib/money";
import { calculateQuote } from "../../lib/quotes/calculate-quote";

export function getStaticPaths() {
  return prebuilds.map((prebuild) => ({
    params: { slug: prebuild.slug },
    props: { prebuild },
  }));
}

interface Props {
  prebuild: PrebuiltPC;
}

const { prebuild } = Astro.props;

// Re-derive the quote breakdown at render time so the page discloses the
// component subtotal, confirmed service fee, fixed margin, percentage margin,
// total margin, and final total as separate line items.
const catalogPrebuild = catalog.byPrebuildSlug.get(prebuild.slug);
const quote = catalogPrebuild
  ? calculateQuote(
      {
        componentIds: catalogPrebuild.componentIds,
        serviceId: catalogPrebuild.serviceId,
        pricingPolicyId: catalogPrebuild.pricingPolicyId,
      },
      catalog,
      new Date(),
    )
  : null;
const breakdown = quote?.ok ? quote.quote.lines : null;

const pageMeta = {
  title: `${prebuild.name} | smart-pc`,
  description: prebuild.tagline,
};
---

<BaseLayout {...pageMeta}>
  <Navbar slot="navbar" />

  <!-- Header -->
  <section class="bg-navy-950 py-16">
    <div class="mx-auto max-w-7xl px-4">
      <a
        href="/pre-armadas"
        class="mb-6 inline-flex items-center gap-2 text-sm text-text-secondary hover:text-cyan-500"
      >
        ← Volver a pre-armadas
      </a>
      <div
        class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
      >
        <div>
          {
            prebuild.badge && (
              <span class="mb-2 inline-block rounded-full bg-cyan-500/10 px-3 py-1 text-xs font-medium text-cyan-500">
                {prebuild.badge}
              </span>
            )
          }
          <h1 class="text-3xl font-bold text-text-primary md:text-4xl">
            {prebuild.name}
          </h1>
          <p class="mt-1 text-text-secondary">{prebuild.tagline}</p>
        </div>
        <div class="text-right">
          {
            prebuild.basePrice === null ? (
              <>
                <div class="text-4xl font-bold text-amber-400">
                  Pendiente de confirmación
                </div>
                <div class="mt-2 text-sm text-text-muted">
                  Esta configuración incluye componentes sin precio
                  exacto confirmado. Te enviaremos una cotización
                  detallada por WhatsApp al contactarnos.
                </div>
              </>
            ) : (
              <>
                <div class="text-4xl font-bold text-cyan-500">
                  {formatCop(prebuild.basePrice)}
                </div>
                <div class="text-sm text-text-muted">COP · IVA incluido</div>
              </>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Spec list -->
  <section class="bg-navy-950 py-12">
    <div class="mx-auto max-w-4xl px-4">
      <h2 class="mb-6 text-xl font-semibold text-text-primary">
        Componentes incluidos
      </h2>
      <SpecList components={prebuild.components} variant="list" />
      {
        prebuild.basePrice === null && (
          <p class="mt-4 text-xs text-amber-400">
            Esta configuración incluye componentes con precio no
            confirmado. Te contactaremos por WhatsApp para confirmar
            antes de cotizar.
          </p>
        )
      }
    </div>
  </section>

  <!-- Quote breakdown (PR 2) -->
  {
    breakdown && (
      <section class="bg-navy-950 py-12">
        <div class="mx-auto max-w-4xl px-4">
          <h2 class="mb-6 text-xl font-semibold text-text-primary">
            Desglose del precio (COP)
          </h2>
          <div class="overflow-hidden rounded-2xl border border-border bg-navy-900">
            <table class="w-full text-left text-sm">
              <thead class="bg-navy-800 text-text-muted">
                <tr>
                  <th class="px-4 py-3 font-mono text-xs uppercase tracking-wider">
                    Concepto
                  </th>
                  <th class="px-4 py-3 text-right font-mono text-xs uppercase tracking-wider">
                    Importe
                  </th>
                </tr>
              </thead>
              <tbody>
                {breakdown.map((line) => (
                  <tr
                    class="border-t border-border"
                    class:list={[
                      line.kind === "total" && "bg-navy-800 font-semibold",
                    ]}
                  >
                    <td class="px-4 py-3 text-text-primary">
                      {line.label}
                      {line.kind === "percentage-margin" && line.rate !== undefined && (
                        <span class="ml-2 text-xs text-text-muted">
                          ({line.rate}%)
                        </span>
                      )}
                    </td>
                    <td
                      class="px-4 py-3 text-right font-mono text-cyan-500"
                      class:list={[line.kind === "total" && "text-lg"]}
                    >
                      {formatCop(line.amountCop)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="mt-4 text-xs text-text-muted">{PRICE_VARIATION_NOTICE}</p>
        </div>
      </section>
    )
  }

  <!-- CTA -->
  <section class="bg-navy-950 py-12">
    <div class="mx-auto max-w-2xl px-4 text-center">
      <h2 class="mb-4 text-2xl font-bold text-text-primary">
        ¿Te interesa esta configuración?
      </h2>
      <p class="mb-8 text-text-secondary">
        Escribinos por WhatsApp o mail. Te ayudamos a elegir la mejor opción
        para vos.
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="https://wa.me/573001234567"
          rel="noopener noreferrer"
          target="_blank"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-cyan-500 px-8 py-3.5 font-bold text-navy-950 transition-colors hover:bg-cyan-400"
        >
          Consultar por WhatsApp
        </a>
        <CTAButton href="/configurar" variant="outline">
          Modificar en configurador
        </CTAButton>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  document.addEventListener('click', (e) => {
    const nav = document.getElementById('main-nav');
    const toggle = document.getElementById('nav-toggle');
    if (nav && toggle) {
      if (toggle.contains(e.target)) { nav.classList.toggle('hidden'); }
      else if (!nav.contains(e.target) && !nav.classList.contains('hidden')) { nav.classList.add('hidden'); }
    }
  });
</script>
