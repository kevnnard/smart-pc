---
/**
 * FAQItem.astro
 *
 * Single accordion row in the FAQ section (F1.9). Uses the native
 * `<details>`/`<summary>` pair so open/close state requires zero JavaScript,
 * keeps the page JS budget at zero, and inherits all browser-native
 * accessibility affordances.
 *
 * Props:
 *   - item:  FAQItem from `src/data/types.ts`
 *   - index: number — the 0-based position, used to render the
 *                     `// 01` … `// 0N` monospace label that matches the
 *                     design language of the other home sections.
 *   - class?: string — utility classes appended to the <details> root.
 *
 * Visual:
 *   - closed: navy-900 surface with a 1px subtle border
 *   - open:   same surface, border tints cyan, chevron rotates 180°
 *
 * `list-none` + the explicit `marker:hidden` Tailwind class strip the default
 * `<summary>` triangle so the only indicator is the custom chevron SVG.
 */
import type { FAQItem } from "../../data/types";

interface Props {
  readonly item: FAQItem;
  readonly index: number;
  readonly class?: string;
}

const { item, index, class: extraClass = "" } = Astro.props;

const paddedIndex = String(index + 1).padStart(2, "0");
---

<details
  class:list={[
    "group rounded-xl border border-border bg-navy-900 open:border-cyan-500/30",
    "transition-colors duration-150",
    extraClass,
  ]}
>
  <summary
    class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-text-primary select-none marker:hidden"
  >
    <div class="flex items-center gap-4">
      <span
        class="font-mono text-xs tracking-widest text-cyan-500"
        aria-hidden="true"
      >
        // {paddedIndex}
      </span>
      <span class="text-sm font-medium">{item.question}</span>
    </div>
    <svg
      class="h-5 w-5 shrink-0 text-cyan-500 transition-transform duration-200 group-open:rotate-180"
      viewBox="0 0 20 20"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        fill-rule="evenodd"
        d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
        clip-rule="evenodd"
      />
    </svg>
  </summary>
  <div class="px-5 pb-5 text-sm leading-relaxed text-text-secondary">
    {item.answer}
  </div>
</details>