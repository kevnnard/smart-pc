---
import type { ServiceRecord } from "../../data/types";
/**
 * ServiceCard.astro
 *
 * Single tile in the services grid (F1.5 + F5.2). Renders a service's icon,
 * title, one-line description, and a price surface selected in this order:
 *
 *   1. `service.priceLabel` — verbatim string (no `Desde`, no formatting).
 *      Used by Home-only `HomeServiceRecord` entries whose public price is not
 *      a single integer COP value (e.g. `Precio según configuración`,
 *      `Incluido / según diagnóstico`).
 *   2. `service.startingPrice` — formatted with `formatCop()` from
 *      `src/lib/money.ts` and prefixed with `Desde`.
 *
 * If neither is present, no price surface is rendered (no misleading
 * `Desde $0` placeholder).
 *
 * Props:
 *   - service: ServiceRecord from `src/data/types.ts` (or the
 *              Home-only `HomeServiceRecord` view model which adds the
 *              optional `priceLabel` field).
 *   - class?:  string — utility classes appended to the card root.
 *
 * Visual:
 *   - navy surface (`bg-navy-900` ≈ `#141b2c`) with `rounded-2xl`
 *   - lifts on hover with a subtle translate + cyan shadow glow
 *   - icon rendered as text (emoji) so no extra asset pipeline is needed
 *
 * Pricing notes (post PR 2):
 *   - `service.startingPrice` is integer whole COP (see `src/data/types.ts`).
 *     Rendered with `formatCop()` from `src/lib/money.ts`.
 *   - For `confirmed` services this equals the confirmed fee; for
 *     `recommended` services this is the lower bound of the recommended
 *     range; for `reference` services this is the reference price when
 *     present. A recommendation is structurally NEVER surfaced as a
 *     confirmed price.
 */
import { formatCop } from "../../lib/money";

interface Props {
  readonly service:
    | ServiceRecord
    | (ServiceRecord & { readonly priceLabel?: string });
  readonly class?: string;
}

const { service, class: extraClass = "" } = Astro.props;

const priceLabel: string | undefined = (
  service as ServiceRecord & { readonly priceLabel?: string }
).priceLabel;
const startingPrice: number | undefined = service.startingPrice;
const showPrice = priceLabel !== undefined || startingPrice !== undefined;
---

<div
  class:list={[
    "group relative overflow-hidden rounded-2xl bg-navy-900 p-6 transition-all duration-200",
    "hover:-translate-y-1 hover:bg-navy-700 hover:shadow-xl hover:shadow-cyan-500/5",
    extraClass,
  ]}
>
  <div class="mb-4 text-4xl" aria-hidden="true">
    {service.icon}
  </div>

  <h3 class="mb-2 text-lg font-semibold text-text-primary">
    {service.title}
  </h3>

  <p class="mb-4 text-sm leading-relaxed text-text-secondary">
    {service.description}
  </p>

  {
    showPrice && (
      <div class="font-mono text-xs uppercase tracking-wider text-cyan-500">
        {priceLabel !== undefined ? (
          priceLabel
        ) : (
          <>Desde {formatCop(startingPrice as number)}</>
        )}
      </div>
    )
  }
</div>