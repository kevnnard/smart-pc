---
import type { Component, ComponentCategory } from "../../data/types";
/**
 * SpecList.astro
 *
 * Compact "spec sheet" view of a `Component[]`. Two-row layout per item:
 *   - Top:    category badge + brand badge + model + info flyout (small)
 *   - Bottom: top 3 specs (left) + price (right)
 */
import { formatCop, PRICE_VARIATION_NOTICE } from "../../lib/money";

interface Props {
  readonly components: readonly Component[];
  readonly variant?: "list" | "grid";
  readonly class?: string;
}

const { components, variant = "list", class: extraClass = "" } = Astro.props;

interface CategoryMeta {
  readonly abbr: string;
}

const CATEGORY_LABEL: Record<ComponentCategory, CategoryMeta> = {
  cpu: { abbr: "CPU" },
  gpu: { abbr: "GPU" },
  motherboard: { abbr: "MB" },
  ram: { abbr: "RAM" },
  storage: { abbr: "SSD" },
  psu: { abbr: "PSU" },
  cooler: { abbr: "FAN" },
  case: { abbr: "CASE" },
  os: { abbr: "SO" },
};

const BRAND_COLOR: Record<string, string> = {
  AMD: "bg-rose-500/15 text-rose-300 ring-rose-400/40",
  NVIDIA: "bg-emerald-500/15 text-emerald-300 ring-emerald-400/40",
  Intel: "bg-sky-500/15 text-sky-300 ring-sky-400/40",
  ASUS: "bg-fuchsia-500/15 text-fuchsia-300 ring-fuchsia-400/40",
  "ASUS ROG": "bg-pink-500/15 text-pink-300 ring-pink-400/40",
  MSI: "bg-indigo-500/15 text-indigo-300 ring-indigo-400/40",
  Gigabyte: "bg-violet-500/15 text-violet-300 ring-violet-400/40",
  Corsair: "bg-amber-500/15 text-amber-300 ring-amber-400/40",
  "Kingston Fury": "bg-red-500/15 text-red-300 ring-red-400/40",
  Kingston: "bg-red-500/15 text-red-300 ring-red-400/40",
  "G.Skill": "bg-orange-500/15 text-orange-300 ring-orange-400/40",
  GSkill: "bg-orange-500/15 text-orange-300 ring-orange-400/40",
  Samsung: "bg-blue-500/15 text-blue-300 ring-blue-400/40",
  "Western Digital": "bg-sky-500/15 text-sky-300 ring-sky-400/40",
  WD: "bg-sky-500/15 text-sky-300 ring-sky-400/40",
  Seagate: "bg-teal-500/15 text-teal-300 ring-teal-400/40",
  Noctua: "bg-yellow-700/15 text-yellow-300 ring-yellow-500/40",
  NZXT: "bg-purple-500/15 text-purple-300 ring-purple-400/40",
  "Cooler Master": "bg-purple-500/15 text-purple-300 ring-purple-400/40",
  CM: "bg-purple-500/15 text-purple-300 ring-purple-400/40",
  DeepCool: "bg-lime-500/15 text-lime-300 ring-lime-400/40",
  "Be quiet": "bg-zinc-500/15 text-zinc-300 ring-zinc-400/40",
  EVGA: "bg-green-500/15 text-green-300 ring-green-400/40",
  Sapphire: "bg-blue-500/15 text-blue-300 ring-blue-400/40",
  PowerColor: "bg-orange-600/15 text-orange-300 ring-orange-500/40",
  XFX: "bg-red-600/15 text-red-300 ring-red-500/40",
  "Lian Li": "bg-stone-500/15 text-stone-300 ring-stone-400/40",
  Phanteks: "bg-cyan-500/15 text-cyan-300 ring-cyan-400/40",
  "Fractal Design": "bg-stone-500/15 text-stone-300 ring-stone-400/40",
  Logitech: "bg-slate-500/15 text-slate-300 ring-slate-400/40",
  Razer: "bg-lime-500/15 text-lime-300 ring-lime-400/40",
  HyperX: "bg-red-500/15 text-red-300 ring-red-400/40",
};

function brandClass(brand: string): string {
  return (
    BRAND_COLOR[brand] || "bg-slate-500/15 text-slate-300 ring-slate-400/40"
  );
}

function formatSpecValue(value: string): string {
  return value.replace(/,/g, ", ");
}
---

<div
  class:list={[
    variant === "grid"
      ? "grid grid-cols-1 gap-2 md:grid-cols-2"
      : "flex flex-col gap-1.5",
    extraClass,
  ]}
  role="list"
>
  {
    components.map((comp) => {
      const catMeta = CATEGORY_LABEL[comp.category];
      return (
        <div
          role="listitem"
          class="flex flex-col gap-1 rounded-lg border border-border/40 bg-navy-900/40 px-3 py-2 transition-colors hover:border-cyan-500/40 hover:bg-navy-900"
        >
          <!-- Row 1: badges + model + info button (compact, post-title) -->
          <div class="flex items-center gap-2">
            <span class="inline-flex shrink-0 items-center rounded-md bg-navy-950/70 px-1.5 py-0.5 font-mono text-[9px] font-bold uppercase tracking-widest text-cyan-300 ring-1 ring-cyan-500/30">
              {catMeta.abbr}
            </span>
            <span
              class:list={[
                "inline-flex shrink-0 items-center rounded-md px-1.5 py-0.5 font-mono text-[9px] font-bold uppercase tracking-widest ring-1",
                brandClass(comp.brand),
              ]}
            >
              {comp.brand}
            </span>
            <p class="min-w-0 flex-1 truncate text-sm font-semibold text-text-primary">{comp.model}</p>

            <!-- Compact info button — sits after the title, smaller pulse -->
            <div class="group/flyout relative shrink-0 inline-flex">
              <button
                type="button"
                class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-cyan-500/15 text-cyan-400 ring-1 ring-cyan-400/40 transition-colors hover:bg-cyan-500/25 hover:text-cyan-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400"
                aria-label="Condiciones del precio"
                tabindex="0"
              >
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cyan-400 opacity-25"></span>
                <svg
                  class="relative h-3 w-3"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
              </button>
              <div
                role="tooltip"
                class="pointer-events-none absolute right-0 top-full z-50 mt-2 hidden w-64 rounded-xl border border-cyan-500/30 bg-navy-950 p-3 text-xs text-text-secondary shadow-xl backdrop-blur-md group-hover/flyout:block group-focus-within/flyout:block"
              >
                <div class="flex items-center gap-1.5 mb-1">
                  <span class="h-1.5 w-1.5 rounded-full bg-cyan-400"></span>
                  <p class="font-mono text-[10px] font-bold uppercase tracking-wider text-cyan-400">
                    Condiciones del precio
                  </p>
                </div>
                <p class="leading-relaxed text-text-primary text-[12px] font-medium">
                  {PRICE_VARIATION_NOTICE}
                </p>
              </div>
            </div>
          </div>

          <!-- Row 2: specs (left) + price (right) -->
          <div class="flex items-center justify-between gap-3 pl-1">
            <p class="flex flex-wrap gap-x-3 gap-y-0.5 text-[11px] text-text-secondary">
              {Object.entries(comp.specs)
                .slice(0, 3)
                .map(([k, v]) => (
                  <span>
                    <span class="text-text-muted">{k}:</span>{" "}
                    <span class="font-mono">{formatSpecValue(v)}</span>
                  </span>
                ))}
            </p>

            {comp.price === null ? (
              <span class="shrink-0 rounded-full border border-amber-500/40 bg-amber-500/10 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-amber-400">
                Por cotizar
              </span>
            ) : (
              <span class="shrink-0 font-mono text-xs font-semibold text-cyan-400">
                {formatCop(comp.price)}
              </span>
            )}
          </div>
        </div>
      );
    })
  }
</div>
