---
import type { Component } from "../../data/types";
/**
 * SpecList.astro
 *
 * Compact "spec sheet" view of a `Component[]`. Used inside the prebuild
 * detail page (`/pre-armadas/[slug]`, F3.x) and any future spec surfaces
 * (configurator review step, services page parts table, etc.).
 *
 * Props:
 *   - components: readonly Component[] from `src/data/types.ts`
 *   - variant?:   "list" | "grid" — defaults to "list". The list variant is
 *                  a vertical stack of zebra-striped rows; the grid variant
 *                  renders the same data as a 2-column responsive grid (used
 *                  for narrow sidebars and configurator review).
 *   - class?:     string — utility classes appended to the root element.
 *
 * Each row shows brand + model on a single line, the first three spec
 * key/value pairs beneath it, and the price on the right edge in cyan.
 *
 * Pricing notes (post PR 2 / Slice 2):
 *   - `comp.price` is integer whole COP. Rendered with `formatCop()` from
 *     `src/lib/money.ts` — no `/ 100` cent conversion.
 *   - When `comp.price === null` (the multi-offer shape's `unconfirmed`
 *     case), the row renders the "Precio no confirmado" badge instead of
 *     a fabricated zero. The maintainer never gets a "$ 0" surprise.
 */
import { formatCop } from "../../lib/money";

interface Props {
  readonly components: readonly Component[];
  readonly variant?: "list" | "grid";
  readonly class?: string;
}

const { components, variant = "list", class: extraClass = "" } = Astro.props;

function formatSpecValue(value: string): string {
  // Long socket lists ("AM4,AM5,LGA1700") get a single space after each comma
  // so they breathe when rendered next to other specs.
  return value.replace(/,/g, ", ");
}
---

<div
  class:list={[
    variant === "grid"
      ? "grid grid-cols-1 gap-2 md:grid-cols-2"
      : "flex flex-col gap-1",
    extraClass,
  ]}
  role="list"
>
  {
    components.map((comp, i) => (
      <div
        role="listitem"
        class:list={[
          "flex items-center justify-between gap-4 rounded-lg px-3 py-2",
          variant === "list" && (i % 2 === 0 ? "bg-navy-900" : "bg-navy-700"),
          variant === "grid" && "bg-navy-900",
        ]}
      >
        <div class="min-w-0 flex-1">
          <div class="truncate text-sm font-medium text-text-primary">
            {comp.brand} {comp.model}
          </div>
          <div class="mt-0.5 flex flex-wrap gap-x-3 gap-y-0.5 text-xs text-text-secondary">
            {Object.entries(comp.specs)
              .slice(0, 3)
              .map(([k, v]) => (
                <span>
                  <span class="text-text-muted">{k}:</span>{" "}
                  {formatSpecValue(v)}
                </span>
              ))}
          </div>
        </div>
        <div
          class:list={[
            "shrink-0 font-mono text-sm font-semibold",
            comp.price === null ? "text-amber-400" : "text-cyan-500",
          ]}
        >
          {comp.price === null ? "Precio no confirmado" : formatCop(comp.price)}
        </div>
      </div>
    ))
  }
</div>
