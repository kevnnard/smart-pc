---
/**
 * TrustStrip.astro
 *
 * A 4-column "trust signal" row that sits below the home hero and the home
 * catalog teasers. Each cell pairs an inline cyan SVG icon with a short label
 * and a tiny descriptor.
 *
 * Content is hardcoded for V1 — the data file is intentionally lightweight and
 * lives in src/data/home.ts only for richer home-page copy.
 */
interface TrustItem {
  label: string;
  detail: string;
  // 24x24 viewBox path data for the leading icon.
  iconPath: string;
}

const items: TrustItem[] = [
  {
    label: "Garantía 12 meses",
    detail: "Cobertura completa en todas las PCs.",
    iconPath:
      "M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3zm-1.2 13.3-3.6-3.6 1.4-1.4 2.2 2.2 5.6-5.6 1.4 1.4-7 7z",
  },
  {
    label: "Envío gratis",
    detail: "A todo el país a partir de $X (+info).",
    iconPath:
      "M3 4h12v3h3l3 4v6h-3a3 3 0 1 1-6 0H9a3 3 0 1 1-6 0V4zm14 6h2.4L17 7.5V10zM6 17a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zm12 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z",
  },
  {
    label: "Soporte 24/7",
    detail: "WhatsApp, mail y ticket.",
    iconPath:
      "M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 17h-2v-2h2zm2.07-7.75-.9.92A3.39 3.39 0 0 0 13 14.5h-2v-.5a4.39 4.39 0 0 1 1.17-2.83l1.24-1.26A1.99 1.99 0 0 0 13 6a2 2 0 0 0-4 0H7a4 4 0 0 1 8 0 3.18 3.18 0 0 1-.93 2.25z",
  },
  {
    label: "Pago seguro",
    detail: "Mercado Pago, transferencia, tarjeta.",
    iconPath:
      "M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 6a3 3 0 0 1 3 3v1h-2v-1a1 1 0 1 0-2 0v1H9v-1a3 3 0 0 1 3-3zm-3 6h6v3a3 3 0 0 1-6 0v-3z",
  },
];

interface Props {
  class?: string;
}

const { class: extraClass = "" } = Astro.props;
---

<section
  class:list={[
    "border-y border-border bg-navy-900/50",
    extraClass,
  ]}
  aria-label="Garantías y servicios"
>
  <div
    class="mx-auto grid w-full max-w-[1280px] grid-cols-1 gap-6 px-4 py-6 sm:grid-cols-2 md:grid-cols-4 md:px-8"
  >
    {
      items.map((item) => (
        <div class="flex items-start gap-3">
          <span
            class="inline-flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-md bg-navy-800 text-cyan-500 ring-1 ring-cyan-500/30"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-5 w-5"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d={item.iconPath} />
            </svg>
          </span>
          <div class="space-y-0.5">
            <p class="text-sm font-semibold text-text-primary">{item.label}</p>
            <p class="text-xs leading-relaxed text-text-secondary">
              {item.detail}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>
