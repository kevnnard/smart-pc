---
/**
 * Footer.astro
 *
 * Site-wide footer for smart-pc.
 *   - Logo: Clean SVG wordmark mirroring the Navbar styling (SMART-PC).
 *   - Category links: Query parameters for `nuqs` (?categoria=...) so clicking
 *     takes the user straight to filtered results in `/productos`.
 *   - Dynamic copyright year via `new Date().getFullYear()`.
 *   - Direct GitHub credit to founder @kevnnard for credibility.
 *   - Verified WhatsApp +57 318 546 7155.
 */
const currentYear = new Date().getFullYear();

interface Column {
  title: string;
  links: { label: string; href: string }[];
}

const productLinks: Column["links"] = [
  { label: "Todos los componentes", href: "/productos" },
  { label: "Procesadores (CPU)", href: "/productos?categoria=cpu" },
  { label: "Tarjetas de video (GPU)", href: "/productos?categoria=gpu" },
  { label: "Placas base", href: "/productos?categoria=motherboard" },
  { label: "Memorias RAM", href: "/productos?categoria=ram" },
  { label: "Almacenamiento (SSD/HDD)", href: "/productos?categoria=storage" },
  { label: "Fuentes de poder", href: "/productos?categoria=psu" },
  { label: "Chasis / Gabinetes", href: "/productos?categoria=case" },
  { label: "Refrigeración", href: "/productos?categoria=cooler" },
  { label: "Monitores", href: "/productos?categoria=monitor" },
  { label: "Periféricos", href: "/productos?categoria=peripheral" },
];

const serviceLinks: Column["links"] = [
  { label: "PC Pre-armadas", href: "/pre-armadas" },
  { label: "Armá tu PC a medida", href: "/configurar" },
  { label: "Servicios de taller", href: "/servicios" },
  { label: "Mantenimiento y upgrades", href: "/servicios#servicios" },
  { label: "Garantía y soporte", href: "/garantia" },
];

const infoLinks: Column["links"] = [
  { label: "Sobre nosotros", href: "/nosotros" },
  { label: "Métodos de pago", href: "/pagos" },
  { label: "Envíos y entregas", href: "/envios" },
  { label: "Política de garantía", href: "/garantia" },
  { label: "Términos y condiciones", href: "/legal/terminos" },
  { label: "Política de privacidad", href: "/legal/privacidad" },
  { label: "Preguntas frecuentes (FAQ)", href: "/faq" },
  { label: "Contacto directo", href: "/contacto" },
];

interface SocialLink {
  label: string;
  href: string;
  /** Inline SVG path data, 24x24 viewBox. */
  path: string;
}

