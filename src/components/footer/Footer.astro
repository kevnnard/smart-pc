interface PaymentChip {
  label: string;
  name: string;
  bgClass: string;
}

const payments: PaymentChip[] = [
  { label: "WOMPI", name: "Wompi Bancolombia", bgClass: "bg-[#002d72]" },
  { label: "PSE", name: "PSE", bgClass: "bg-[#003865]" },
  { label: "NEQUI", name: "Nequi", bgClass: "bg-[#200020]" },
  { label: "MP", name: "Mercado Pago", bgClass: "bg-[#00b5e2]" },
  {
    label: "LEMON",
    name: "Lemon Squeezy",
    bgClass: "bg-[#ffc83b] text-navy-950 font-bold",
  },
  { label: "PAYPAL", name: "PayPal", bgClass: "bg-[#003087]" },
];

const whatsappPath =
  "M20.52 3.48A11.86 11.86 0 0 0 12.04 0C5.5 0 .18 5.32.18 11.86c0 2.09.55 4.13 1.59 5.93L0 24l6.36-1.67a11.84 11.84 0 0 0 5.68 1.45h.01c6.54 0 11.86-5.32 11.86-11.86 0-3.17-1.23-6.15-3.39-8.44zM12.05 21.7h-.01a9.83 9.83 0 0 1-5-1.36l-.36-.21-3.78 1 1.01-3.69-.23-.38a9.84 9.84 0 1 1 18.24-5.2c0 5.43-4.42 9.84-9.87 9.84zm5.46-7.36c-.3-.15-1.76-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.88 1.22 3.08c.15.2 2.1 3.21 5.08 4.5.71.31 1.27.49 1.7.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35z";
---

<footer class="bg-navy-950 text-text-secondary border-t border-border/60">
  <!-- Subtle cyan gradient hairline at the top of the footer. -->
  <div
    class="h-px bg-gradient-to-r from-transparent via-cyan-500/60 to-transparent"
    aria-hidden="true"
  ></div>

  <div class="mx-auto w-full max-w-[1280px] px-4 pt-12 pb-8 md:px-8">
    <!-- Top section: brand column + 3 link columns -->
    <div
      class="grid grid-cols-1 gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr] md:gap-12"
    >
      <!-- Brand column -->
      <div class="space-y-4">
        <!-- Logo TEXT wordmark (exacto al Navbar, sin imagen rota) -->
        <a
          href="/"
          class="inline-flex flex-col group transition-all duration-200 hover:opacity-80"
          aria-label="smart-pc — ir al inicio"
        >
          <div class="font-bold tracking-tighter flex items-baseline gap-0.5 text-xl leading-none">
            <span class="text-cyan-400 font-extrabold">SMART</span><span class="text-white">-PC</span>
          </div>
          <span class="font-mono text-[10px] text-white/40 uppercase tracking-widest leading-none mt-1">
            PCs a tu medida
          </span>
        </a>

        <p class="max-w-sm text-xs leading-relaxed text-text-secondary">
          Taller especializado en ensamble de alto rendimiento, optimización térmica y venta de hardware con fuentes verificadas. Desde Bogotá para toda Colombia.
        </p>

        <!-- Redes y perfil de Kevin -->
        <ul class="flex items-center gap-2 pt-1" aria-label="Redes sociales y desarrollador">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  rel="noopener noreferrer"
                  target="_blank"
                  aria-label={s.label}
                  class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-border bg-navy-900/60 text-text-secondary transition-all hover:border-cyan-500/50 hover:bg-navy-800 hover:text-cyan-300"
                  title={s.label}
                >
                  <svg
                    viewBox="0 0 24 24"
                    class="h-3.5 w-3.5"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d={s.path} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>

        <div>
          <a
            href="https://wa.me/573185467155"
            rel="noopener noreferrer"
            target="_blank"
            class="inline-flex items-center gap-2 rounded-xl bg-[#25D366] px-4 py-2 text-xs font-bold text-white shadow-md transition-all hover:brightness-110"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-3.5 w-3.5"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d={whatsappPath} />
            </svg>
            <span>WhatsApp directo</span>
          </a>
        </div>
      </div>

      <!-- Productos con filtro nuqs -->
      <nav aria-label="Catálogo por componentes" class="space-y-3">
        <h2 class="text-xs font-bold uppercase tracking-[0.18em] text-text-primary">
          Catálogo Técnico
          <span
            class="mt-1.5 block h-0.5 w-6 rounded-full bg-cyan-500"
            aria-hidden="true"
          ></span>
        </h2>
        <ul class="space-y-1.5 text-xs">
          {
            productLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-text-secondary transition-colors hover:text-cyan-400"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Servicios -->
      <nav aria-label="Servicios" class="space-y-3">
        <h2 class="text-xs font-bold uppercase tracking-[0.18em] text-text-primary">
          Servicios y PCs
          <span
            class="mt-1.5 block h-0.5 w-6 rounded-full bg-cyan-500"
            aria-hidden="true"
          ></span>
        </h2>
        <ul class="space-y-1.5 text-xs">
          {
            serviceLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-text-secondary transition-colors hover:text-cyan-400"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Información institucional -->
      <nav aria-label="Información institucional" class="space-y-3">
        <h2 class="text-xs font-bold uppercase tracking-[0.18em] text-text-primary">
          Información y Legal
          <span
            class="mt-1.5 block h-0.5 w-6 rounded-full bg-cyan-500"
            aria-hidden="true"
          ></span>
        </h2>
        <ul class="space-y-1.5 text-xs">
          {
            infoLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-text-secondary transition-colors hover:text-cyan-400"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-border/80 bg-navy-950">
    <div
      class="mx-auto flex w-full max-w-[1280px] flex-col items-center justify-between gap-4 px-4 py-5 text-xs text-text-muted md:flex-row md:px-8"
    >
      <div class="flex flex-col items-center gap-1 text-center md:items-start md:text-left">
        <p>© {currentYear} smart-pc. Todos los derechos reservados.</p>
        <p class="text-[11px] text-text-muted">
          Diseñado y desarrollado por{" "}
          <a
            href="https://github.com/kevnnard"
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-cyan-400 hover:underline hover:text-cyan-300"
          >
            Kevin Londoño (@kevnnard)
          </a>
        </p>
      </div>

      <!-- Pasarelas soportadas -->
      <ul class="flex flex-wrap items-center justify-center gap-1.5" aria-label="Pasarelas de pago soportadas">
        {
          payments.map((p) => (
            <li title={p.name}>
              <span
                class={`inline-flex items-center justify-center rounded px-2 py-0.5 text-[9px] font-mono font-bold tracking-wider text-white shadow-sm border border-white/10 ${p.bgClass}`}
              >
                {p.label}
              </span>
            </li>
          ))
        }
      </ul>

      <p class="text-[11px]">
        Hecho en Colombia <span aria-hidden="true">🇨🇴</span>
      </p>
    </div>
  </div>
</footer>
