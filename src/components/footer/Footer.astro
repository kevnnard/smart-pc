interface PaymentChip {
  label: string;
  bgClass: string;
}

/**
 * Placeholder payment-provider chips. The real Stitch icon set will replace
 * these later — for now we render small colored discs with the provider's
 * initials so the layout and color rhythm match the design.
 */
const payments: PaymentChip[] = [
  { label: "VISA", bgClass: "bg-[#1a1f71]" },
  { label: "MC", bgClass: "bg-[#eb001b]" },
  { label: "MP", bgClass: "bg-[#00b5e2]" },
  { label: "NAR", bgClass: "bg-[#ff6600]" },
];

const whatsappPath =
  "M20.52 3.48A11.86 11.86 0 0 0 12.04 0C5.5 0 .18 5.32.18 11.86c0 2.09.55 4.13 1.59 5.93L0 24l6.36-1.67a11.84 11.84 0 0 0 5.68 1.45h.01c6.54 0 11.86-5.32 11.86-11.86 0-3.17-1.23-6.15-3.39-8.44zM12.05 21.7h-.01a9.83 9.83 0 0 1-5-1.36l-.36-.21-3.78 1 1.01-3.69-.23-.38a9.84 9.84 0 1 1 18.24-5.2c0 5.43-4.42 9.84-9.87 9.84zm5.46-7.36c-.3-.15-1.76-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.88 1.22 3.08c.15.2 2.1 3.21 5.08 4.5.71.31 1.27.49 1.7.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35z";
---

<footer class="bg-navy-950 text-text-secondary">
  <!-- Subtle cyan gradient hairline at the top of the footer. -->
  <div
    class="h-px bg-gradient-to-r from-transparent via-cyan-500/60 to-transparent"
    aria-hidden="true"
  ></div>

  <div class="mx-auto w-full max-w-[1280px] px-4 pt-12 pb-8 md:px-8">
    <!-- Top section: brand column + 3 link columns -->
    <div
      class="grid grid-cols-1 gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr] md:gap-12"
    >
      <!-- Brand column -->
      <div class="space-y-5">
        <a
          href="/"
          class="inline-block"
          aria-label="smart-pc — ir al inicio"
        >
          <img src="/logo.svg" alt="smart-pc" class="h-8 w-auto" />
        </a>

        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-cyan-500"
        >
          PCs a tu medida
        </p>

        <p class="max-w-sm text-sm leading-relaxed text-text-secondary">
          Armamos la PC de tus sueños con componentes de primera línea y soporte
          experto. Desde Colombia para el mundo.
        </p>

        <ul class="flex items-center gap-2 pt-1" aria-label="Redes sociales">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  rel="noopener noreferrer"
                  target="_blank"
                  aria-label={s.label}
                  class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border text-text-secondary transition-colors hover:border-cyan-500 hover:text-cyan-500"
                >
                  <svg
                    viewBox="0 0 24 24"
                    class="h-4 w-4"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d={s.path} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>

        <a
          href="https://wa.me/573000000000"
          rel="noopener noreferrer"
          target="_blank"
          class="inline-flex items-center gap-2 rounded-full bg-[#25D366] px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-[#1ebe5d]"
        >
          <svg
            viewBox="0 0 24 24"
            class="h-4 w-4"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d={whatsappPath} />
          </svg>
          WhatsApp
        </a>
      </div>

      <!-- Productos -->
      <nav aria-label="Productos" class="space-y-4">
        <h2
          class="text-sm font-bold uppercase tracking-[0.18em] text-text-primary"
        >
          Productos
          <span
            class="mt-2 block h-0.5 w-8 rounded-full bg-cyan-500"
            aria-hidden="true"
          ></span>
        </h2>
        <ul class="space-y-2 text-sm">
          {
            productLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-text-secondary transition-colors hover:text-cyan-500"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Servicios -->
      <nav aria-label="Servicios" class="space-y-4">
        <h2
          class="text-sm font-bold uppercase tracking-[0.18em] text-text-primary"
        >
          Servicios
          <span
            class="mt-2 block h-0.5 w-8 rounded-full bg-cyan-500"
            aria-hidden="true"
          ></span>
        </h2>
        <ul class="space-y-2 text-sm">
          {
            serviceLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-text-secondary transition-colors hover:text-cyan-500"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Información -->
      <nav aria-label="Información" class="space-y-4">
        <h2
          class="text-sm font-bold uppercase tracking-[0.18em] text-text-primary"
        >
          Información
          <span
            class="mt-2 block h-0.5 w-8 rounded-full bg-cyan-500"
            aria-hidden="true"
          ></span>
        </h2>
        <ul class="space-y-2 text-sm">
          {
            infoLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-text-secondary transition-colors hover:text-cyan-500"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-border">
    <div
      class="mx-auto flex w-full max-w-[1280px] flex-col items-center justify-between gap-4 px-4 py-5 text-xs text-text-muted md:flex-row md:px-8"
    >
      <p>© {year} smart-pc. Todos los derechos reservados.</p>

      <ul class="flex items-center gap-2" aria-label="Métodos de pago">
        {
          payments.map((p) => (
            <li>
              <span
                class={`inline-flex h-6 w-6 items-center justify-center rounded-full text-[9px] font-bold text-white shadow-sm ${p.bgClass}`}
                aria-label={p.label}
              >
                {p.label}
              </span>
            </li>
          ))
        }
      </ul>

      <p>
        Hecho en Colombia <span aria-hidden="true">🇨🇴</span>
      </p>
    </div>
  </div>
</footer>
