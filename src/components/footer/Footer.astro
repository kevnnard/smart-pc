---
/**
 * Footer.astro
 *
 * Site-wide footer for smart-pc. Models the Stitch screen
 * 7b31e97588ae4f6abd53b627a317cb7d:
 *   - navy-950 surface with a thin cyan gradient hairline at the top
 *   - 4-column grid: brand column (logo, tagline, description, socials, WhatsApp
 *     CTA) + Productos / Servicios / Información navigation columns
 *   - bottom bar with copyright, payment-provider placeholders and the
 *     "Hecho en Colombia 🇨🇴" marker.
 *
 * The footer ships zero JavaScript: every link is a plain anchor, every icon is
 * inline SVG, and the social/WhatsApp targets open in a new tab via
 * `target="_blank"` + `rel="noopener noreferrer"`.
 */
const year = Date.now().toLocaleString();

interface Column {
  title: string;
  links: { label: string; href: string }[];
}

const productLinks: Column["links"] = [
  { label: "PC Pre-armadas", href: "/pre-armadas" },
  { label: "Armá tu PC", href: "/configurar" },
  { label: "Componentes", href: "/productos" },
  { label: "Periféricos", href: "/perifericos" },
  { label: "Monitores", href: "/monitores" },
  { label: "Accesorios", href: "/accesorios" },
];

const serviceLinks: Column["links"] = [
  { label: "Armado de PC", href: "/servicios#armado" },
  { label: "Upgrades", href: "/servicios#upgrades" },
  { label: "Reparación", href: "/servicios#reparacion" },
  { label: "Soporte técnico", href: "/servicios#soporte" },
  { label: "Instalación de software", href: "/servicios#software" },
  { label: "Configuración de red", href: "/servicios#red" },
];

const infoLinks: Column["links"] = [
  { label: "Sobre nosotros", href: "/nosotros" },
  { label: "Métodos de pago", href: "/pagos" },
  { label: "Envíos y entregas", href: "/envios" },
  { label: "Política de garantía", href: "/garantia" },
  { label: "Términos y condiciones", href: "/legal/terminos" },
  { label: "FAQ", href: "/faq" },
];

interface SocialLink {
  label: string;
  href: string;
  /** Inline SVG path data, 24x24 viewBox. */
  path: string;
}

const socials: SocialLink[] = [
  {
    label: "Instagram",
    href: "https://instagram.com/smartpc.co",
