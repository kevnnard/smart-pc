---
/**
 * PrebuildTeaser.astro (home section wrapper).
 *
 * Home pre-armadas teaser (F1.6): monospace `// PRE-ARMADAS` eyebrow, a 3-up
 * responsive grid of `PricingCard`s sourced from `src/data/prebuilds.ts`,
 * and an optional outline CTA at the bottom linking to `/pre-armadas`.
 *
 * Props:
 *   - eyebrow?:    string — defaults to "// PRE-ARMADAS".
 *   - heading?:    string — section heading.
 *   - subhead?:    string — short paragraph under the heading.
 *   - showAllHref?: boolean — when true, render a bottom CTA to /pre-armadas.
 *                              Defaults to true.
 *   - class?:      string — utility classes appended to the section root.
 */
import { prebuilds } from "../../data/prebuilds";
import PricingCard from "../ui/PricingCard.astro";

interface Props {
  readonly eyebrow?: string;
  readonly heading?: string;
  readonly subhead?: string;
  readonly showAllHref?: boolean;
  readonly class?: string;
}

const {
  eyebrow = "// PRE-ARMADAS",
  heading = "Tres tiers listos para usar.",
  subhead = "Curamos las configuraciones más populares para que arranques sin dudar. Cada build pasa por validación de compatibilidad y stress-test de 12 horas antes de salir del taller.",
  showAllHref = true,
  class: extraClass = "",
} = Astro.props;
---

<section
  class:list={["w-full bg-navy-950 py-16 md:py-24", extraClass]}
  aria-labelledby="prebuild-teaser-heading"
>
  <div
    class="mx-auto flex w-full max-w-[1280px] flex-col gap-10 px-4 md:px-8"
  >
    <header class="flex flex-col gap-4 text-center md:text-left">
      <span
        class="font-mono text-xs tracking-widest text-cyan-500 md:text-sm"
      >
        {eyebrow}
      </span>
      <h2
        id="prebuild-teaser-heading"
        class="text-3xl font-bold leading-tight text-text-primary md:text-4xl"
      >
        {heading}
      </h2>
      <p class="max-w-2xl text-base leading-relaxed text-text-secondary md:mx-0">
        {subhead}
      </p>
    </header>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        prebuilds.map((prebuild) => (
          <PricingCard prebuild={prebuild} />
        ))
      }
    </div>

    {
      showAllHref && (
        <div class="flex justify-center pt-2">
          <a
            href="/pre-armadas"
            class="font-mono text-xs uppercase tracking-widest text-cyan-500 transition-colors hover:text-cyan-300"
          >
            Ver todas las pre-armadas →
          </a>
        </div>
      )
    }
  </div>
</section>