---
/**
 * PageHero.astro (home section wrapper).
 *
 * Section-level hero used at the top of the home page (F1.2) and reused as a
 * generic page header on /servicios, /contacto, /pre-armadas. It pairs a
 * monospace eyebrow label, a primary H1, a body subhead, and an optional
 * pair of CTAs (primary + outline). When `accent` is provided, the H1 splits
 * onto two lines (the accent rendered in cyan) and a thin cyan gradient
 * underline bar appears beneath the headline as a visual emphasis marker.
 *
 * Props:
 *   - eyebrow?:  string  — small monospace label rendered above the H1
 *                           (e.g. "// CUSTOM PC BUILDER · COLOMBIA").
 *   - title:     string  — primary headline (H1).
 *   - accent?:   string  — optional second-line accent rendered in cyan.
 *                           Appended after `title` with a line break.
 *   - body?:     string  — subhead text, capped at ~640px wide.
 *   - primaryHref?:    string
 *   - primaryLabel?:   string
 *   - outlineHref?:    string
 *   - outlineLabel?:   string
 *   - align?:          "left" | "center" — defaults to "left" on home, set
 *                                            to "center" elsewhere if needed.
 *   - class?: string — utility classes appended to the section root.
 *
 * Composition: imports `CTAButton` from the shared UI library.
 */
import CTAButton from "../ui/CTAButton.astro";
import HeroChassis from "./HeroChassis";

interface Props {
  readonly eyebrow?: string;
  readonly title: string;
  readonly accent?: string;
  readonly body?: string;
  readonly primaryHref?: string;
  readonly primaryLabel?: string;
  readonly outlineHref?: string;
  readonly outlineLabel?: string;
  readonly align?: "left" | "center";
  readonly showChassis?: boolean;
  readonly chassisStatusLabel?: string;
  readonly chassisLocaleLabel?: string;
  readonly stats?: readonly {
    readonly label: string;
    readonly value: string;
  }[];
  readonly class?: string;
}

const {
  eyebrow,
  title,
  accent,
  body,
  primaryHref,
  primaryLabel,
  outlineHref,
  outlineLabel,
  align = "left",
  showChassis = false,
  chassisStatusLabel = "SYS.TEMP: OPTIMAL",
  chassisLocaleLabel = "THE CLOUD: BOGOTÁ D.C.",
  stats = [],
  class: extraClass = "",
} = Astro.props;

const alignment =
  align === "center" ? "items-center text-center" : "items-start text-left";
---

<section
  class:list={[
    "relative isolate w-full overflow-hidden bg-navy-950",
    showChassis && "border-b border-border/60 pt-6 pb-12 md:pt-10 md:pb-16 lg:min-h-[calc(100dvh-4rem)] lg:pt-10",
    !showChassis && "py-20 md:py-28",
    extraClass,
  ]}
>
  <div
    class:list={[
      "mx-auto flex h-full w-full max-w-[1280px] flex-col gap-6 px-6 py-2 sm:px-8 md:flex-row md:items-stretch md:gap-8 md:px-10 md:py-10",
      showChassis ? "lg:min-h-[calc(100dvh-4rem)]" : "",
    ]}
  >
    {
      showChassis && (
        <aside class="pointer-events-none hidden flex-col justify-between pb-2 pt-4 font-mono text-[10px] uppercase tracking-[0.18em] text-cyan-300/80 lg:flex lg:w-12 lg:text-[11px]">
          <span class="-rotate-180 [writing-mode:vertical-rl]">SYS.ONLINE</span>
          <span class="[writing-mode:vertical-rl]">VER 2024.1</span>
        </aside>
      )
    }

    <div
      class:list={[
        "flex w-full flex-col justify-start gap-5 self-start md:justify-center md:gap-6 md:self-center",
        showChassis
          ? "lg:max-w-[640px] lg:flex-1 lg:py-10"
          : "lg:max-w-[640px]",
        alignment,
      ]}
    >
      {
        eyebrow && (
          <span
            class="inline-flex items-center gap-2 self-start font-mono text-[10px] uppercase tracking-[0.18em] text-text-secondary md:text-xs"
          >
            <span class="h-1.5 w-1.5 rounded-sm bg-cyan-400" aria-hidden="true" />
            {eyebrow}
          </span>
        )
      }

      <h1
        class="text-5xl font-bold leading-[1.05] tracking-[-0.04em] text-text-primary md:text-7xl"
      >
        {title}
        {
          accent && (
            <>
              <br />
              <span class="text-cyan-400">{accent}</span>
            </>
          )
        }
      </h1>

      {
        body && (
          <p class="max-w-xl text-base leading-relaxed text-text-secondary md:text-lg">
            {body}
          </p>
        )
      }

      {
        (primaryHref || outlineHref) && (
          <div
            class:list={[
              "mt-2 flex flex-col gap-3 sm:flex-row",
              align === "center" && "justify-center",
              align === "left" && "justify-start",
            ]}
          >
            {primaryHref && primaryLabel && (
              <CTAButton href={primaryHref} variant="primary" size="lg">
                {primaryLabel}
              </CTAButton>
            )}
            {outlineHref && outlineLabel && (
              <CTAButton href={outlineHref} variant="outline" size="lg">
                {outlineLabel}
              </CTAButton>
            )}
          </div>
        )
      }

      {
        showChassis && stats.length > 0 && (
          <dl class="mt-10 grid w-full max-w-md grid-cols-3 gap-x-6 border-t border-border/60 pt-6">
            {stats.map((stat) => (
              <div class="flex flex-col gap-1">
                <dt class="font-mono text-[10px] uppercase tracking-[0.18em] text-text-muted">
                  {stat.label}
                </dt>
                <dd class="font-mono text-lg font-bold text-text-primary md:text-xl">
                  {stat.value}
                </dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>

    {
      showChassis && (
        <>
          <div
            class="relative h-[280px] w-full overflow-hidden md:h-[360px] lg:hidden"
            aria-label="Vista previa de la PC ensamblada"
          >
            <div class="pointer-events-none absolute inset-x-8 top-1/2 h-44 -translate-y-1/2 rounded-full bg-blue-500/10 blur-3xl" aria-hidden="true"></div>
            <HeroChassis client:visible />
          </div>
          <div class="relative hidden flex-1 lg:flex">
            <div
              class="pointer-events-none absolute right-0 top-1/2 -translate-y-1/2 font-mono text-[10px] uppercase leading-relaxed tracking-[0.18em] text-cyan-300/80"
              aria-hidden="true"
            >
              <div class="[writing-mode:vertical-rl]">{chassisStatusLabel}</div>
              <div class="[writing-mode:vertical-rl]">{chassisLocaleLabel}</div>
            </div>
            <div
              class="pointer-events-none absolute inset-10 rounded-full bg-blue-500/8 blur-3xl"
              aria-hidden="true"
            >
            </div>
            <HeroChassis client:visible />
          </div>
        </>
      )
    }
  </div>
</section>
