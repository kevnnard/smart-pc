---
/**
 * ServicesGrid.astro (home section wrapper).
 *
 * Home services grid (F1.5): monospace `// SERVICIOS` eyebrow, a 2×2 grid of
 * `ServiceCard`s (single column on mobile) sourced from the Home-only
 * `homeServices` array in `src/data/home.ts`, and a bottom CTA linking to
 * `/servicios`. The full catalog (research ranges + confirmed fee) remains
 * available to the quote engine via `src/data/catalog/services.json` and is
 * surfaced on `/servicios`; the Home grid deliberately uses a curated
 * commercial-only set.
 *
 * Props:
 *   - eyebrow?:  string — defaults to "// SERVICIOS".
 *   - heading?:  string — section heading.
 *   - subhead?:  string — short paragraph under the heading.
 *   - showAllHref?: boolean — when true, render a bottom CTA to /servicios.
 *                              Defaults to true.
 *   - class?:    string — utility classes appended to the section root.
 */
import { homeServices } from "../../data/home";
import ServiceCard from "../ui/ServiceCard.astro";

interface Props {
  readonly eyebrow?: string;
  readonly heading?: string;
  readonly subhead?: string;
  readonly showAllHref?: boolean;
  readonly class?: string;
}

const {
  eyebrow = "// SERVICIOS",
  heading = "Cuatro servicios, una sola garantía.",
  subhead = "Desde el armado a medida hasta el soporte de por vida. Trabajamos con vos en cada paso para que tu PC sea exactamente lo que necesitás.",
  showAllHref = true,
  class: extraClass = "",
} = Astro.props;
---

<section
  class:list={["w-full bg-navy-900 py-16 md:py-24", extraClass]}
  aria-labelledby="services-grid-heading"
>
  <div
    class="mx-auto flex w-full max-w-[1280px] flex-col gap-10 px-4 md:px-8"
  >
    <header class="flex flex-col gap-4 text-center md:text-left">
      <span
        class="font-mono text-xs tracking-widest text-cyan-500 md:text-sm"
      >
        {eyebrow}
      </span>
      <h2
        id="services-grid-heading"
        class="text-3xl font-bold leading-tight text-text-primary md:text-4xl"
      >
        {heading}
      </h2>
      <p class="max-w-2xl text-base leading-relaxed text-text-secondary">
        {subhead}
      </p>
    </header>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        homeServices.map((service) => (
          <ServiceCard service={service} />
        ))
      }
    </div>

    {
      showAllHref && (
        <div class="flex justify-center pt-2">
          <a
            href="/servicios"
            class="font-mono text-xs uppercase tracking-widest text-cyan-500 transition-colors hover:text-cyan-300"
          >
            Ver todos los servicios →
          </a>
        </div>
      )
    }
  </div>
</section>