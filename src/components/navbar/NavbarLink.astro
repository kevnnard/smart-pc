---
/**
 * NavbarLink.astro
 *
 * Single link rendered inside the smart-pc navbar. Matches the Stitch navbar
 * screen fa168e446daf43698cae0d43a0208c0d link treatments:
 *   - Active link: cyan-400 text + bold + 2px cyan-400 bottom border + pb-1.
 *   - Default: white/60 with cyan-400 hover transition.
 *
 * The slot holds the link label and any trailing decoration (chevron icon, NUEVO
 * badge, etc.). Use the optional `class` prop to add layout-only classes such as
 * `gap-1` (chevron) or `gap-2` (badge) without affecting the link's color rules.
 *
 * Props:
 *   - href:       string   — link target.
 *   - isActive?:  boolean  — when true, applies the active style.
 *   - class?:     string   — additional layout-only utility classes.
 */
interface Props {
  href: string;
  isActive?: boolean;
  class?: string;
}

const { href, isActive = false, class: extraClass = "" } = Astro.props;
---

<a
  href={href}
  aria-current={isActive ? "page" : undefined}
  class:list={[
    "text-sm h-full flex items-center transition-colors duration-200",
    isActive
      ? "text-cyan-400 font-bold border-b-2 border-cyan-400 pb-1"
      : "text-white/60 hover:text-cyan-400",
    extraClass,
  ]}
>
  <slot />
</a>
