---
/**
 * Navbar.astro
 *
 * Sticky top navigation for smart-pc. Faithfully reproduces the Stitch navbar
 * screen fa168e446daf43698cae0d43a0208c0d:
 *
 *   - `<nav>` is fixed, full-width, z-50, with a glassmorphism surface
 *     (#0c1333 / 70 + backdrop-blur-xl + 1px white/10 border) and a 1px gradient
 *     accent hairline along the bottom edge.
 *   - Brand is a TEXT wordmark — `<span class="text-cyan-400">SMART</span>` plus
 *     `<span class="text-white">-PC</span>` — with a mono tagline below.
 *   - Five centered links (Inicio / Pre-armadas / Configurador / Servicios /
 *     Contacto). Default styling is white/60 with cyan-400 on hover; the active
 *     link gets a cyan-400 underline (border-b-2) plus bold text. Pre-armadas
 *     carries a chevron; Configurador carries a "NUEVO" badge pill.
 *   - Right cluster (desktop): ES locale chip, cart icon, cyan-400 CTA pill
 *     "Arma el tuyo" with a settings cog.
 *   - Mobile (< md): the cluster collapses to a hamburger that toggles a
 *     dropdown menu (`#mobile-menu`) — same `is:inline` toggle pattern used by
 *     the page-level fallbacks. Per-link `currentPath` is honored so the active
 *     page keeps its cyan underline on the small menu too.
 */
import NavbarLink from "./NavbarLink.astro";

interface Props {
  /** Path of the current page; used to mark the matching link as active. */
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems: {
  href: string;
  label: string;
  /** Decoration trailing the label. `none` renders the plain link. */
  trailing?: "chevron" | "badge";
  /** Badge text, only meaningful when `trailing === "badge"`. */
  badge?: string;
}[] = [
  { href: "/", label: "Inicio" },
  { href: "/pre-armadas", label: "Pre-armadas", trailing: "chevron" },
  {
    href: "/configurar",
    label: "Configurador",
    trailing: "badge",
    badge: "NUEVO",
  },
  { href: "/servicios", label: "Servicios" },
  { href: "/contacto", label: "Contacto" },
];

const isActive = (href: string): boolean => {
  if (href === "/") {
    return currentPath === "/";
  }
  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<nav
  class="fixed top-0 w-full z-50 bg-[#0c1333]/70 backdrop-blur-xl border-b border-white/10 duration-200 ease-in-out"
  aria-label="Principal"
>
  <!-- Accent Line: 1px gradient hairline at the bottom of the nav -->
  <div
    class="absolute bottom-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-cyan-400/50 to-transparent opacity-50"
    aria-hidden="true"
  ></div>

  <div
    class="flex justify-between items-center h-16 px-4 md:px-8 max-w-[1280px] mx-auto"
  >
    <!-- Brand: TEXT wordmark (NOT an image) -->
    <a
      href="/"
      class="flex flex-col group transition-all duration-200 ease-in-out hover:opacity-80"
    >
      <div
        class="font-bold tracking-tighter flex items-baseline gap-0.5 text-base leading-none"
      >
        <span class="text-cyan-400">SMART</span><span class="text-white">-PC</span
        >
      </div>
      <span
        class="font-mono text-[10px] text-white/40 uppercase tracking-widest leading-none mt-1"
      >
        PCs a tu medida
      </span>
    </a>

    <!-- Nav links (centered, gap-8, hidden on mobile) -->
    <ul class="hidden md:flex items-center gap-8 h-full">
      {
        navItems.map((item) => (
          <li class="h-full flex items-center">
            <NavbarLink
              href={item.href}
              isActive={isActive(item.href)}
              class={item.trailing === "chevron"
                ? "gap-1"
                : item.trailing === "badge"
                  ? "gap-2"
                  : ""}
            >
              {item.label}
              {item.trailing === "chevron" && (
                <svg
                  class="w-4 h-4"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
                    clip-rule="evenodd"
                  />
                </svg>
              )}
              {item.trailing === "badge" && item.badge && (
                <span class="bg-blue-600 text-white px-1.5 py-0.5 rounded-full font-mono text-[10px] leading-none border border-blue-400/50 shadow-[0_0_8px_rgba(5,102,217,0.4)]">
                  {item.badge}
                </span>
              )}
            </NavbarLink>
          </li>
        ))
      }
    </ul>

    <!-- Right cluster (desktop only): locale chip + cart + cyan CTA -->
    <div class="hidden md:flex items-center gap-6">
      <!-- Locale chip + cart grouped behind a vertical divider -->
      <div class="flex items-center gap-4 border-r border-white/10 pr-6">
        <!-- ES locale chip (static, no click) -->
        <span
          class="font-mono text-[10px] text-white/60 bg-white/5 px-1.5 py-1 border border-white/10"
          aria-label="Idioma: Español"
        >
          ES
        </span>
        <!-- Cart icon button -->
        <button
          type="button"
          aria-label="Carrito"
          class="text-white/60 hover:text-cyan-400 transition-colors p-2"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"
            ></path>
          </svg>
        </button>
      </div>

      <!-- Primary CTA: cyan pill with dark text -->
      <a
        href="/configurar"
        class="bg-cyan-400 text-[#0c1324] px-6 py-2.5 font-bold text-[14px] uppercase tracking-wider hover:bg-cyan-300 transition-all duration-200 border border-transparent shadow-[0_0_15px_rgba(34,211,238,0.15)] flex items-center gap-2"
      >
        <svg
          class="w-[18px] h-[18px]"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
          ></path>
        </svg>
        Arma el tuyo
      </a>
    </div>

    <!-- Mobile hamburger (visible < md) -->
    <button
      id="nav-toggle"
      type="button"
      class="md:hidden text-white/60 p-2"
      aria-label="Menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile dropdown menu (hidden by default; toggled by #nav-toggle) -->
  <div
    id="mobile-menu"
    class="hidden border-t border-white/10 bg-[#0c1333]/95 backdrop-blur-md md:hidden"
  >
    <ul class="mx-auto flex max-w-[1280px] flex-col gap-1 px-4 py-3">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors",
                isActive(item.href)
                  ? "bg-white/5 text-cyan-400"
                  : "text-white/60 hover:bg-white/5 hover:text-cyan-400",
              ]}
            >
              <span>{item.label}</span>
              {item.trailing === "badge" && item.badge && (
                <span class="bg-blue-600 text-white px-1.5 py-0.5 rounded-full font-mono text-[10px] leading-none border border-blue-400/50 shadow-[0_0_8px_rgba(5,102,217,0.4)]">
                  {item.badge}
                </span>
              )}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a
          href="/configurar"
          class="bg-cyan-400 text-[#0c1324] flex items-center justify-center gap-2 px-6 py-2.5 font-bold text-sm uppercase tracking-wider hover:bg-cyan-300 transition-all duration-200 w-full"
        >
          <svg
            class="w-[18px] h-[18px]"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
            ></path>
          </svg>
          Arma el tuyo
        </a>
      </li>
    </ul>
  </div>
</nav>

<script is:inline>
  (() => {
    const toggle = document.getElementById("nav-toggle");
    const menu = document.getElementById("mobile-menu");
    if (!toggle || !menu) return;

    const setExpanded = (expanded) => {
      toggle.setAttribute("aria-expanded", expanded ? "true" : "false");
    };

    const closeMenu = () => {
      menu.classList.add("hidden");
      setExpanded(false);
    };

    toggle.addEventListener("click", (event) => {
      event.stopPropagation();
      if (menu.classList.contains("hidden")) {
        menu.classList.remove("hidden");
        setExpanded(true);
      } else {
        closeMenu();
      }
    });

    document.addEventListener("click", (event) => {
      if (menu.classList.contains("hidden")) return;
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (!menu.contains(target) && !toggle.contains(target)) {
        closeMenu();
      }
    });
  })();
</script>
