---
/**
 * Navbar.astro
 *
 * Sticky top navigation for smart-pc. Models the Stitch navbar screen
 * fa168e446daf43698cae0d43a0208c0d:
 *   - glassmorphism background (deep-navy tint with backdrop blur)
 *   - left: wordmark "smart" (cyan) + "-pc" (white) with tagline
 *   - center: nav links (Inicio / Pre-armadas / Configurador / Servicios /
 *     Contacto) with cyan underline on hover and an active-state underline
 *   - right: primary "Arma el tuyo" CTA, cart icon, ES locale chip
 *   - bottom edge: 1px gradient cyan hairline
 *   - mobile (< md): collapses to a hamburger that toggles a dropdown menu.
 *     Kept intentionally simple — no overlay, no animations beyond a show/hide.
 */
import CTAButton from "../ui/CTAButton.astro";
import NavbarLink from "./NavbarLink.astro";

interface Props {
  /** Path of the current page; used to mark the matching link as active. */
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems: {
  href: string;
  label: string;
  hasChevron?: boolean;
  badge?: string;
}[] = [
  { href: "/", label: "Inicio" },
  { href: "/pre-armadas", label: "Pre-armadas", hasChevron: true },
  { href: "/configurar", label: "Configurador", badge: "Cobalto" },
  { href: "/servicios", label: "Servicios" },
  { href: "/contacto", label: "Contacto" },
];

const isActive = (href: string): boolean => {
  if (href === "/") {
    return currentPath === "/";
  }
  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header
  class="sticky top-0 z-50 w-full border-b border-cyan-500/40 backdrop-blur-md"
  style="background-color: rgba(12, 19, 36, 0.8);"
>
  <nav
    class="mx-auto flex h-16 w-full max-w-[1280px] items-center justify-between gap-6 px-4 md:px-8"
    aria-label="Principal"
  >
    <!-- Wordmark + tagline -->
    <a
      href="/"
      class="group flex items-center gap-3"
      aria-label="smart-pc — ir al inicio"
    >
      <img src="/logo.jpg" alt="smart-pc" class="h-8 w-auto" />
      <span
        class="hidden text-xs font-medium text-text-secondary md:inline-block"
      >
        PCs a tu medida
      </span>
    </a>

    <!-- Center links (desktop only) -->
    <ul class="hidden flex-1 items-center justify-center gap-2 md:flex">
      {
        navItems.map((item) => (
          <li>
            <NavbarLink href={item.href} isActive={isActive(item.href)}>
              {item.label}
              {item.hasChevron && (
                <svg
                  class="h-3 w-3 text-text-secondary transition-transform group-hover:translate-y-0.5"
                  viewBox="0 0 12 12"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <path
                    d="M3 4.5 6 7.5l3-3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              )}
              {item.badge && (
                <span
                  class="ml-1 inline-flex items-center rounded-full bg-blue-500 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-text-primary"
                >
                  {item.badge}
                </span>
              )}
            </NavbarLink>
          </li>
        ))
      }
    </ul>

    <!-- Right cluster (desktop) -->
    <div class="hidden items-center gap-3 md:flex">
      <CTAButton href="/configurar" variant="primary" size="sm">
        Arma el tuyo
      </CTAButton>

      <button
        type="button"
        aria-label="Carrito"
        class="relative inline-flex h-9 w-9 items-center justify-center rounded-full border border-border text-text-primary transition-colors hover:border-cyan-500 hover:text-cyan-500"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          aria-hidden="true"
        >
          <path
            d="M3 4h2l2.4 12.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.5L21 8H6"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <circle cx="10" cy="20" r="1.4" fill="currentColor" />
          <circle cx="17" cy="20" r="1.4" fill="currentColor" />
        </svg>
      </button>

      <span
        class="inline-flex items-center gap-1 rounded-full border border-border px-2 py-1 text-xs font-medium text-text-secondary"
        aria-label="Idioma y región: Español de Colombia"
      >
        ES
        <span aria-hidden="true">🇨🇴</span>
      </span>
    </div>

    <!-- Mobile: hamburger toggle -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-border text-text-primary md:hidden"
      aria-label="Abrir menú"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-mobile-menu-toggle
    >
      <svg
        viewBox="0 0 24 24"
        class="h-5 w-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          d="M4 7h16M4 12h16M4 17h16"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>
  </nav>

  <!-- Mobile dropdown (hidden by default; toggled by inline script) -->
  <div
    id="mobile-menu"
    class="hidden border-t border-border bg-navy-950/95 backdrop-blur-md md:hidden"
    data-mobile-menu
  >
    <ul class="mx-auto flex max-w-[1280px] flex-col gap-1 px-4 py-3">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "block rounded-md px-3 py-2 text-sm font-medium transition-colors",
                isActive(item.href)
                  ? "bg-navy-800 text-cyan-500"
                  : "text-text-secondary hover:bg-navy-800 hover:text-text-primary",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <CTAButton href="/configurar" variant="primary" size="md" class="w-full">
          Arma el tuyo
        </CTAButton>
      </li>
    </ul>
  </div>
</header>

<script is:inline>
  document.addEventListener('click', (e) => {
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;
    if (toggle.contains(e.target) || e.target === toggle) {
      menu.classList.toggle('hidden');
    } else if (!menu.contains(e.target)) {
      menu.classList.add('hidden');
    }
  });
</script>
