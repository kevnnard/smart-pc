---
/**
 * ProductCard.astro
 *
 * Single-product card on the `/productos/` page and any future listing
 * surface that needs to expose a single component with its price, stock
 * status, and provenance links. Implements the Kinetic Performance brief:
 *   - Dark `border border-border` container with hover highlight
 *   - Top image fallback tile (deterministic monogram + category badge)
 *   - Category label (uppercase mono) + Stock status badge
 *   - Title (Brand + Model)
 *   - Monospace specs strip (`// spec1`, `// spec2`, …)
 *   - Price block: COP formatted when `hasExactPrice`; otherwise
 *     "Precio provisional" or "Precio por confirmar" in amber — never $0
 *   - Provenance footer: retailer, checked date, and external link
 *     ("Ver oferta original" when single offer, "Comparar ofertas" when 2+)
 *
 * Pricing caveat: the shared `PRICE_VARIATION_NOTICE` is rendered below
 * the card so the no-fabrication / manual-confirmation rule is visible.
 */
import { formatCop, PRICE_VARIATION_NOTICE } from "../../lib/money";
import type { ProductViewModel } from "../../lib/products/catalog-view-model";
import StockBadge from "./StockBadge.astro";

interface Props {
  readonly product: ProductViewModel;
  readonly class?: string;
}

const { product, class: extraClass = "" } = Astro.props;

const priceLabel =
  product.hasExactPrice && product.referencePriceCop !== undefined
    ? formatCop(product.referencePriceCop)
    : product.isUnconfirmed
      ? "Precio por confirmar"
      : "Precio provisional";

const priceClass = product.hasExactPrice
  ? product.isVerified
    ? "text-cyan-400"
    : "text-amber-400"
  : "text-amber-400";

const retailerLabel = product.selectedRetailer ?? "Fuente por confirmar";
const sourceUrl = product.selectedSourceUrl;
const checkedAt = product.selectedCheckedAt;

function formatColDate(isoString?: string): string | undefined {
  if (!isoString) return undefined;
  try {
    const d = new Date(isoString);
    if (Number.isNaN(d.getTime())) return isoString;
    return new Intl.DateTimeFormat("es-CO", {
      day: "numeric",
      month: "short",
      year: "numeric",
      timeZone: "America/Bogota",
    }).format(d);
  } catch {
    return isoString;
  }
}

const formattedCheckedAt = formatColDate(checkedAt);
const restockNote = product.restockNote;

// Deterministic 2-letter monogram for the image fallback. Uses brand/model
// initials; falls back to category id + a static glyph if the brand is
// missing. Pure function of `product.id` so the rendering is stable across
// renders (good for diff-based screen reviews).
const safeBrand = (product.brand ?? "").trim();
const safeModel = (product.model ?? "").trim();
const monogram =
  (safeBrand[0] ?? product.categoryId[0] ?? "?").toUpperCase() +
  (safeBrand[1] ?? product.categoryId[1] ?? " ").toUpperCase();
const categoryShort = product.categoryId.toUpperCase();

// Monospace specs strip. Show at most the first three entries so the card
// stays compact; the full specs remain on the configurator and prebuild
// surfaces, never on the catalog tile.
const specsEntries = Object.entries(product.specs).slice(0, 3);

// "Ver oferta original" for single offer, "Comparar ofertas" for 2+ offers.
// Both labels keep `rel="nofollow noopener external"` per the trust policy.
const offerLabel = product.hasMultipleOffers
  ? `Comparar ${product.offers.length} ofertas`
  : "Ver oferta original";

// Native brand accent palette: colors, borders, and badge styling per brand
function getBrandBadgeStyle(brandName: string): {
  text: string;
  bg: string;
  border: string;
  dot: string;
} {
  const norm = brandName.toLowerCase().trim();
  if (norm.includes("amd")) {
    return {
      text: "text-red-400",
      bg: "bg-red-500/10",
      border: "border-red-500/30",
      dot: "bg-red-500",
    };
  }
  if (norm.includes("nvidia")) {
    return {
      text: "text-emerald-400",
      bg: "bg-emerald-500/10",
      border: "border-emerald-500/30",
      dot: "bg-emerald-400",
    };
  }
  if (norm.includes("intel")) {
    return {
      text: "text-sky-400",
      bg: "bg-sky-500/10",
      border: "border-sky-500/30",
      dot: "bg-sky-400",
    };
  }
  if (norm.includes("asus") || norm.includes("rog")) {
    return {
      text: "text-rose-400",
      bg: "bg-rose-500/10",
      border: "border-rose-500/30",
      dot: "bg-rose-500",
    };
  }
  if (norm.includes("msi")) {
    return {
      text: "text-red-400",
      bg: "bg-red-500/10",
      border: "border-red-500/30",
      dot: "bg-red-500",
    };
  }
  if (norm.includes("corsair")) {
    return {
      text: "text-amber-400",
      bg: "bg-amber-500/10",
      border: "border-amber-500/30",
      dot: "bg-amber-400",
    };
  }
  if (norm.includes("kingston")) {
    return {
      text: "text-red-400",
      bg: "bg-red-500/10",
      border: "border-red-500/30",
      dot: "bg-red-500",
    };
  }
  if (norm.includes("g.skill")) {
    return {
      text: "text-amber-400",
      bg: "bg-amber-500/10",
      border: "border-amber-500/30",
      dot: "bg-amber-400",
    };
  }
  if (norm.includes("samsung")) {
    return {
      text: "text-blue-400",
      bg: "bg-blue-500/10",
      border: "border-blue-500/30",
      dot: "bg-blue-500",
    };
  }
  if (norm.includes("western digital") || norm.includes("wd")) {
    return {
      text: "text-blue-400",
      bg: "bg-blue-500/10",
      border: "border-blue-500/30",
      dot: "bg-blue-500",
    };
  }
  if (norm.includes("seagate")) {
    return {
      text: "text-emerald-400",
      bg: "bg-emerald-500/10",
      border: "border-emerald-500/30",
      dot: "bg-emerald-400",
    };
  }
  if (norm.includes("nzxt")) {
    return {
      text: "text-purple-400",
      bg: "bg-purple-500/10",
      border: "border-purple-500/30",
      dot: "bg-purple-400",
    };
  }
  if (norm.includes("noctua")) {
    return {
      text: "text-amber-500",
      bg: "bg-amber-600/10",
      border: "border-amber-600/30",
      dot: "bg-amber-600",
    };
  }
  if (norm.includes("deepcool")) {
    return {
      text: "text-cyan-400",
      bg: "bg-cyan-500/10",
      border: "border-cyan-500/30",
      dot: "bg-cyan-400",
    };
  }
  if (norm.includes("cooler master")) {
    return {
      text: "text-purple-400",
      bg: "bg-purple-500/10",
      border: "border-purple-500/30",
      dot: "bg-purple-400",
    };
  }
  if (norm.includes("arctic")) {
    return {
      text: "text-sky-400",
      bg: "bg-sky-500/10",
      border: "border-sky-500/30",
      dot: "bg-sky-400",
    };
  }
  if (norm.includes("microsoft")) {
    return {
      text: "text-blue-400",
      bg: "bg-blue-500/10",
      border: "border-blue-500/30",
      dot: "bg-blue-400",
    };
  }
  return {
    text: "text-cyan-400",
    bg: "bg-cyan-500/10",
    border: "border-cyan-500/30",
    dot: "bg-cyan-400",
  };
}

const brandStyle = getBrandBadgeStyle(safeBrand);

const sourceAriaLabel = sourceUrl
  ? product.hasMultipleOffers
    ? `Comparar ofertas observadas para ${product.brand} ${product.model} (se abre en una pestaña nueva)`
    : `Ver oferta observada en ${retailerLabel} para ${product.brand} ${product.model} (se abre en una pestaña nueva)`
  : undefined;
---

<article
  class:list={[
    "group relative flex h-full flex-col gap-4 rounded-2xl border border-border bg-navy-900 p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-cyan-500/40 hover:shadow-[0_12px_28px_-12px_rgba(34,211,238,0.45)] data-[hidden=true]:hidden",
    extraClass,
  ]}
  data-product-card
  data-component-id={product.id}
  data-category={product.categoryId}
  data-brand={product.brand.toLowerCase().trim()}
  data-stock-status={product.stockStatus}
  data-price-status={product.priceStatus}
>
  <!-- Top tile: product image or fallback with monogram + category badge. -->
  <div
    class:list={[
        "relative flex h-36 items-center justify-center overflow-hidden rounded-xl border border-border transition-colors group-hover:border-cyan-500/40",
        product.hasImage && product.imageUrl ? "bg-white" : "bg-navy-800 group-hover:bg-navy-800/80",
      ]}
  >
    {product.hasImage && product.imageUrl ? (
      <img
        src={product.imageUrl}
        alt={`${product.brand} ${product.model}`}
        class="h-full w-full object-contain p-2 transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <span class="font-mono text-3xl font-bold text-text-muted opacity-30" aria-hidden="true">
        {monogram}
      </span>
    )}
    <span
      class="absolute bottom-2 right-3 rounded-full border border-cyan-500/40 bg-navy-950/90 px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-widest text-cyan-400 font-semibold shadow-sm backdrop-blur-sm"
      aria-hidden="true"
    >
      {categoryShort}
    </span>
    {!product.hasImage && (
      <span class="sr-only">
        Imagen no disponible; usamos un placeholder con la inicial del componente.
      </span>
    )}
  </div>

  <!-- Brand badge with native branding palette + Stock badge -->
  <header class="flex items-start justify-between gap-3">
    <span
      class:list={[
        "inline-flex items-center gap-1.5 rounded-md border px-2 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider",
        brandStyle.bg,
        brandStyle.border,
        brandStyle.text,
      ]}
    >
      <span class:list={["h-1.5 w-1.5 rounded-full", brandStyle.dot]} aria-hidden="true"></span>
      <span>{product.brand}</span>
    </span>
    <StockBadge
      stockStatus={product.stockStatus}
      stockQuantity={product.stockQuantity}
      size="sm"
    />
  </header>

  <!-- Title (Model only): clean, prominent, single-line truncate -->
  <h3
    class="text-base md:text-lg font-semibold text-text-primary truncate"
    title={`${product.brand} ${product.model}`}
  >
    <span>{product.model}</span>
  </h3>

  <!-- Specs grid: 2 columns, max 5 rows, clean and compact -->
  {specsEntries.length > 0 && (
    <div class="grid grid-cols-2 gap-x-3 gap-y-1.5 font-mono text-[11px] leading-tight w-full">
      {specsEntries.slice(0, 10).map(([key, value]) => (
        <div class="flex items-baseline justify-between overflow-hidden rounded bg-navy-800/60 px-2 py-1 border border-border/50">
          <span class="text-text-muted truncate mr-1">{key}:</span>
          <span class="text-text-primary font-medium truncate shrink-0">{value}</span>
        </div>
      ))}
    </div>
  )}

  <!-- Price section: Price on the left, Restock icon on the right (space-between) -->
  <div class="border-t border-border pt-3.5 space-y-2">
    <div class="flex items-center justify-between gap-3 w-full">
      {product.hasExactPrice ? (
        <span class:list={["font-mono text-2xl font-extrabold tracking-tight", priceClass]}>
          {priceLabel}
        </span>
      ) : (
        <span class="font-mono text-2xl font-extrabold tracking-tight text-amber-400">
          $ ~
        </span>
      )}
      
      <div class="flex items-center gap-2">
        {product.isProvisional && (
          <span class="rounded-full border border-amber-500/40 bg-amber-500/10 px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-amber-400">
            Provisional
          </span>
        )}
        {product.isUnconfirmed && (
          <span class="rounded-full border border-amber-500/40 bg-amber-500/10 px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-amber-400">
            Por cotizar
          </span>
        )}
        {restockNote && (
          <div class="group/tooltip relative inline-flex items-center">
            <button
              type="button"
              class="relative flex items-center justify-center h-7 w-7 rounded-full bg-purple-500/15 border border-purple-500/40 text-purple-400 hover:text-purple-300 hover:bg-purple-500/25 transition-all shadow-sm focus:outline-none"
              aria-label={`Información de reposición: ${restockNote}`}
            >
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-purple-400 opacity-25"></span>
              <svg class="relative h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </button>
            <div
              role="tooltip"
              class="pointer-events-none absolute bottom-full right-0 z-50 mb-2.5 hidden w-64 rounded-xl border border-purple-500/40 bg-navy-950 p-3 text-xs text-text-secondary shadow-2xl backdrop-blur-md group-hover/tooltip:block group-focus-within/tooltip:block"
            >
              <div class="flex items-center gap-1.5 mb-1.5">
                <span class="h-1.5 w-1.5 rounded-full bg-purple-400"></span>
                <p class="font-mono text-[10px] font-bold uppercase tracking-wider text-purple-400">
                  Nota de reposición
                </p>
              </div>
              <p class="leading-relaxed text-text-primary text-[12px] font-medium">{restockNote}</p>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Provenance footer: smaller unified typography (text-[11px]) with Colombian date -->
  <div class="space-y-1 text-[11px] pt-1">
    <p class="flex items-center gap-1.5 leading-tight">
      <span class="text-text-muted">Fuente:</span>
      <span class={product.selectedRetailer ? "font-medium text-text-secondary" : "font-medium text-amber-400"}>
        {product.selectedRetailer ?? "Fuente por confirmar"}
      </span>
    </p>
    <p class="flex items-center gap-1.5 leading-tight">
      <span class="text-text-muted">Verificado:</span>
      {formattedCheckedAt ? (
        <span class="font-medium text-text-secondary">{formattedCheckedAt}</span>
      ) : (
        <span class="font-medium text-amber-400">No ha sido verificado</span>
      )}
    </p>
  </div>

  <!-- Action buttons: perfectly leveled h-10 height, premium styling, matching font & radius -->
  <div class="mt-3 flex items-center gap-2.5 pt-2 border-t border-border/40">
    <a
      href={`/configurar?item=${product.id}`}
      class="group/btn relative flex-1 inline-flex h-10 items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-cyan-400 to-cyan-300 px-4 text-xs font-black tracking-wider uppercase text-navy-950 shadow-md shadow-cyan-500/10 transition-all duration-200 hover:from-cyan-300 hover:to-cyan-200 hover:shadow-cyan-400/40 hover:-translate-y-0.5 active:translate-y-0 focus:outline-none focus:ring-2 focus:ring-cyan-400 focus:ring-offset-2 focus:ring-offset-navy-900 hover:animate-pulse"
    >
      <svg class="h-4 w-4 transition-transform duration-200 group-hover/btn:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
      </svg>
      <span class="font-extrabold tracking-wider">Armar PC</span>
    </a>

    {sourceUrl ? (
      <a
        href={sourceUrl}
        target="_blank"
        rel="nofollow noopener external"
        aria-label={sourceAriaLabel}
        class="group/offer inline-flex h-10 items-center justify-center gap-1.5 rounded-xl border border-border/70 bg-navy-800/80 px-3.5 text-xs font-semibold text-text-secondary transition-all duration-200 hover:border-cyan-500/50 hover:bg-navy-750 hover:text-text-primary hover:-translate-y-0.5 active:translate-y-0 focus:outline-none focus:ring-2 focus:ring-border"
        title={offerLabel}
      >
        <span>Oferta</span>
        <svg
          class="h-3.5 w-3.5 opacity-60 transition-all duration-200 group-hover/offer:translate-x-0.5 group-hover/offer:-translate-y-0.5 group-hover/offer:opacity-100 group-hover/offer:text-cyan-400"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    ) : (
      <button
        type="button"
        disabled
        class="inline-flex h-10 items-center justify-center gap-1.5 rounded-xl border border-border/30 bg-navy-900/40 px-3.5 text-xs font-semibold text-text-muted/60 cursor-not-allowed"
        title="Oferta pendiente de confirmación"
      >
        <span>Oferta</span>
      </button>
    )}
  </div>

    <!-- Notice footer: discreet tag with popover/flyout on hover -->
  <div class="relative group/notice border-t border-border/40 pt-2">
    <button
      type="button"
      class="flex items-center gap-1.5 font-mono text-[10px] text-text-muted hover:text-cyan-400 transition-colors cursor-pointer w-fit focus:outline-none"
    >
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-cyan-500/60 group-hover/notice:bg-cyan-400 transition-colors"></span>
      <span class="underline decoration-dotted underline-offset-2">Condiciones del precio</span>
      <svg class="h-3 w-3 opacity-60 group-hover/notice:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </button>
    
    <!-- Flyout Drawer/Card popping above -->
    <div
      role="tooltip"
      class="pointer-events-none absolute bottom-full left-0 right-0 z-40 mb-2 hidden rounded-xl border border-cyan-500/30 bg-navy-950/95 p-3.5 shadow-2xl backdrop-blur-md transition-all group-hover/notice:block group-focus-within/notice:block"
    >
      <div class="flex items-start gap-2">
        <svg class="h-4 w-4 text-cyan-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div class="space-y-1">
          <p class="font-mono text-[10px] font-bold uppercase tracking-wider text-cyan-400">
            Aviso de Transparencia
          </p>
          <p class="text-[11px] leading-relaxed text-text-secondary font-normal">
            {PRICE_VARIATION_NOTICE}
          </p>
        </div>
      </div>
    </div>
  </div>
</article>
