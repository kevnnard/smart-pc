---
/**
 * ProductInventory.astro
 *
 * Full catalog inventory grid for `/productos/` (Kinetic Performance layout).
 *
 * Server-renders every `ProductCard` so the page is SEO-friendly and the
 * catalog is reachable without JavaScript; the React filter island
 * `ProductFilters` mutates the visible/hidden state of the cards via
 * `data-` attributes once it hydrates.
 *
 * Layout (12-column grid):
 *   - Left sidebar (`lg:col-span-3`) hosts the `<ProductFilters>` island
 *     (categories + price-status + stock-status + brands).
 *   - Right pane (`lg:col-span-9`) hosts:
 *       1. Top bar: live counter + standalone search input + sort dropdown
 *       2. 3-column product catalog grid (`[data-inventory-grid]`)
 *
 * No data fetching at view time; every card is a pre-rendered Astro element.
 */
import type { ProductViewModel } from "../../lib/products/catalog-view-model";
import ProductCard from "./ProductCard.astro";
import ProductFilters from "./ProductFilters.tsx";
import ProductSearchInput from "./ProductSearchInput.tsx";
import ProductSortSelect from "./ProductSortSelect.tsx";

interface Props {
  readonly products: readonly ProductViewModel[];
}

const { products } = Astro.props;
const totalCount = products.length;
---

<section
  class="space-y-8"
  data-inventory
  data-total-count={totalCount}
  aria-labelledby="inventory-heading"
>
  <header class="space-y-2">
    <p
      class="font-mono text-[10px] uppercase tracking-widest text-cyan-400 font-semibold"
    >
      CATÁLOGO TÉCNICO
    </p>
    <h2
      id="inventory-heading"
      class="text-2xl font-bold text-text-primary md:text-3xl"
    >
      Catálogo de componentes
    </h2>
    <p class="max-w-3xl text-text-secondary text-sm leading-relaxed">
      {totalCount} productos observados en retailers colombianos. Los precios
      son observaciones verificadas o provisionales; verificá el badge de cada
      producto y la fuente antes de comprar.
    </p>
  </header>

  <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
    <!-- Sidebar: filter island (col-span-3) -->
    <aside
      class="space-y-4 lg:col-span-3"
      data-inventory-sidebar
      aria-label="Filtros del catálogo"
    >
      <div
        class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto rounded-2xl border border-border bg-navy-900/60 p-5 shadow-sm scrollbar-thin scrollbar-thumb-navy-800"
        data-sidebar-panel
      >
        <ProductFilters products={products} client:load />
      </div>
    </aside>

    <!-- Main: top control bar (counter + search + sort) + 3-col grid (col-span-9) -->
    <div
      class="space-y-6 lg:col-span-9"
      data-inventory-main
    >
      <div class="sticky top-20 z-30 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between py-3 px-4 rounded-2xl bg-navy-950/90 backdrop-blur-md border border-border shadow-xl shadow-navy-950/60 mb-2">
        <p
          class="font-mono text-xs uppercase tracking-wider text-text-muted shrink-0"
          aria-live="polite"
        >
          <span
            class="font-bold text-text-primary"
            data-product-count
            data-total-count={totalCount}
            >Mostrando {totalCount} de {totalCount} productos</span
          >
        </p>

        <!-- Search input standing on its own -->
        <div class="flex-1 max-w-md w-full sm:mx-4">
          <ProductSearchInput client:load />
        </div>

        <div data-sort-control class="shrink-0">
          <ProductSortSelect client:load />
        </div>
      </div>

      <div
        class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3"
        data-inventory-grid
        role="list"
      >
        {products.map((product) => (
          <div role="listitem" class="contents">
            <ProductCard product={product} />
          </div>
        ))}
      </div>

      <!-- Empty state: shown by the filter island via data-empty-state when no cards are visible -->
      <div
        data-empty-state
        class="sticky top-20 hidden flex-col items-center justify-center gap-6 rounded-2xl border border-border/60 bg-navy-900/40 px-8 py-20 text-center"
        aria-live="polite"
        role="status"
      >
        <!-- Icon -->
        <div class="relative flex items-center justify-center">
          <div class="h-20 w-20 rounded-full bg-navy-800/80 ring-1 ring-border flex items-center justify-center">
            <svg
              viewBox="0 0 24 24"
              class="h-9 w-9 text-text-muted"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-3.5-3.5" stroke-linecap="round" />
              <path d="M8.5 11h5" stroke-linecap="round" />
            </svg>
          </div>
          <div class="absolute -right-1 -top-1 h-5 w-5 rounded-full bg-cyan-500/10 ring-1 ring-cyan-500/30 flex items-center justify-center">
            <span class="text-[10px] text-cyan-400 font-bold">0</span>
          </div>
        </div>

        <!-- Copy -->
        <div class="space-y-1.5">
          <p class="text-base font-semibold text-text-primary">Sin resultados</p>
          <p class="text-sm text-text-muted max-w-xs leading-relaxed">
            Ningún componente coincide con los filtros activos. Probá ampliando la búsqueda o limpiando los filtros.
          </p>
        </div>

        <!-- Clear filters hint -->
        <button
          type="button"
          data-clear-filters
          class="rounded-xl border border-cyan-500/30 bg-cyan-500/10 px-5 py-2 text-xs font-semibold text-cyan-300 transition-all hover:bg-cyan-500/20 hover:text-cyan-200 cursor-pointer"
        >
          Limpiar filtros
        </button>
      </div>
    </div>
  </div>
</section>
